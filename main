main.Name = "Anti hub"
main.BackgroundColor3 = colors.main
main.BorderSizePixel = 0
main.Position = UDim2.new(0, 14, 0, 23)
main.Size = UDim2.new(0, 612, 0, 447)
main.Parent = gui
stroke(main, rgb(62, 63, 80))


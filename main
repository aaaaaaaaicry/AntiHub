local function iconButton(symbol, order)
	local button = new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = theme.panel,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = order,
		Size = UDim2.fromOffset(28, 28),
		Text = symbol,
		TextColor3 = theme.dim,
		TextSize = 23,
		Parent = topIcons,
	}, {
		corner(6),
	})

	button.MouseEnter:Connect(function()
		tween(button, 0.16, { BackgroundTransparency = 0.25, TextColor3 = theme.text })
	end)
	button.MouseLeave:Connect(function()
		tween(button, 0.16, { BackgroundTransparency = 1, TextColor3 = theme.dim })
	end)

	return button
end


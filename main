-- Anti hub UI Library
-- Luau / Roblox Studio friendly UI library.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Library = {}
Library.__index = Library

local RED = Color3.fromRGB(176, 42, 48)
local RED_LIGHT = Color3.fromRGB(224, 74, 80)
local BG = Color3.fromRGB(34, 35, 45)
local BG_DARK = Color3.fromRGB(28, 29, 39)
local PANEL = Color3.fromRGB(39, 40, 52)
local STROKE = Color3.fromRGB(55, 56, 74)
local TEXT = Color3.fromRGB(219, 219, 228)
local MUTED = Color3.fromRGB(139, 139, 153)

local function tween(object, time, props, style, direction)
	local info = TweenInfo.new(
		time or 0.16,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)

	local animation = TweenService:Create(object, info, props)
	animation:Play()
	return animation
end

local function addStroke(parent, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or STROKE
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0
	stroke.Parent = parent
	return stroke
end

local function makeCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 0)
	corner.Parent = parent
	return corner
end

local function makeLabel(parent, text, size, position, color, alignment)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = Enum.Font.Code
	label.Text = text or ""
	label.TextColor3 = color or TEXT
	label.TextSize = size or 12
	label.TextXAlignment = alignment or Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Position = position or UDim2.new()
	label.Size = UDim2.new(1, 0, 0, 18)
	label.Parent = parent
	return label
end

local function makeButton(parent, text, height)
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BackgroundColor3 = PANEL
	button.BorderSizePixel = 0
	button.Font = Enum.Font.Code
	button.Text = text or ""
	button.TextColor3 = TEXT
	button.TextSize = 12
	button.Size = UDim2.new(1, 0, 0, height or 18)
	button.Parent = parent

	addStroke(button, STROKE)
	return button
end

local function clickFlash(object, baseColor)
	local basePosition = object.Position
	local base = baseColor or object.BackgroundColor3

	tween(object, 0.1, {
		BackgroundColor3 = RED_LIGHT,
		Position = basePosition + UDim2.new(0, 7, 0, 0)
	})

	task.delay(0.1, function()
		if object and object.Parent then
			tween(object, 0.18, {
				BackgroundColor3 = base,
				Position = basePosition
			})
		end
	end)
end

local function makeDraggable(topbar, frame)
	local dragging = false
	local dragStart
	local startPos

	topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)

	topbar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

function Library.new(config)
	config = config or {}

	local self = setmetatable({}, Library)
	self.Name = config.Name or "Anti hub"
	self.Accent = config.Accent or RED
	self.Tabs = {}
	self.ActiveTab = nil

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = self.Name:gsub("%s+", "") .. "UI"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = config.Parent or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
	self.Gui = screenGui

	local main = Instance.new("Frame")
	main.Name = "Main"
	main.BackgroundColor3 = BG
	main.BorderSizePixel = 0
	main.Position = config.Position or UDim2.new(0, 14, 0, 24)
	main.Size = config.Size or UDim2.new(0, 610, 0, 446)
	main.Parent = screenGui
	self.Main = main
	addStroke(main, Color3.fromRGB(67, 68, 84), 1)

	local topbar = Instance.new("Frame")
	topbar.Name = "Topbar"
	topbar.BackgroundColor3 = Color3.fromRGB(31, 32, 42)
	topbar.BorderSizePixel = 0
	topbar.Size = UDim2.new(1, 0, 0, 22)
	topbar.Parent = main
	addStroke(topbar, Color3.fromRGB(42, 43, 57), 1, 0.4)

	local title = makeLabel(topbar, self.Name, 12, UDim2.new(0, 0, 0, 0), TEXT, Enum.TextXAlignment.Center)
	title.Size = UDim2.new(1, 0, 1, 0)

	local sidebar = Instance.new("Frame")
	sidebar.Name = "Sidebar"
	sidebar.BackgroundColor3 = BG_DARK
	sidebar.BorderSizePixel = 0
	sidebar.Position = UDim2.new(0, 14, 0, 24)
	sidebar.Size = UDim2.new(0, 98, 1, -34)
	sidebar.Parent = main
	addStroke(sidebar, Color3.fromRGB(46, 47, 62), 1)

	local tabList = Instance.new("UIListLayout")
	tabList.SortOrder = Enum.SortOrder.LayoutOrder
	tabList.Padding = UDim.new(0, 8)
	tabList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	tabList.Parent = sidebar

	local tabPadding = Instance.new("UIPadding")
	tabPadding.PaddingTop = UDim.new(0, 16)
	tabPadding.Parent = sidebar

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.Position = UDim2.new(0, 118, 0, 24)
	content.Size = UDim2.new(1, -130, 1, -34)
	content.Parent = main
	self.Content = content
	self.Sidebar = sidebar

	makeDraggable(topbar, main)

	return self
end

function Library:CreateTab(name, icon)
	local tab = {}
	tab.Name = name
	tab.Controls = {}

	local tabButton = Instance.new("TextButton")
	tabButton.Name = name .. "Tab"
	tabButton.AutoButtonColor = false
	tabButton.BackgroundColor3 = BG_DARK
	tabButton.BorderSizePixel = 0
	tabButton.Font = Enum.Font.Code
	tabButton.Text = (icon and (icon .. "\n") or "") .. name
	tabButton.TextColor3 = MUTED
	tabButton.TextSize = 13
	tabButton.Size = UDim2.new(1, -18, 0, 72)
	tabButton.Parent = self.Sidebar
	tab.Button = tabButton

	local page = Instance.new("Frame")
	page.Name = name .. "Page"
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.Size = UDim2.new(1, 0, 1, 0)
	page.Visible = false
	page.Parent = self.Content
	tab.Page = page

	local section = Instance.new("Frame")
	section.Name = "Section"
	section.BackgroundColor3 = Color3.fromRGB(36, 37, 49)
	section.BorderSizePixel = 0
	section.Position = UDim2.new(0, 0, 0, 0)
	section.Size = UDim2.new(0, 238, 0, 178)
	section.Parent = page
	addStroke(section, Color3.fromRGB(50, 51, 68), 1)
	tab.Section = section

	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 5)
	list.Parent = section

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 18)
	padding.PaddingLeft = UDim.new(0, 7)
	padding.PaddingRight = UDim.new(0, 7)
	padding.Parent = section

	local heading = makeLabel(section, name, 11, nil, TEXT)
	heading.LayoutOrder = -10
	heading.Size = UDim2.new(1, 0, 0, 14)

	function tab:Show()
		for _, item in pairs(self.Library.Tabs) do
			item.Page.Visible = false
			item.Button.TextColor3 = MUTED
			item.Button.BackgroundColor3 = BG_DARK
		end

		page.Visible = true
		tabButton.TextColor3 = TEXT
		tabButton.BackgroundColor3 = Color3.fromRGB(33, 34, 45)
		self.Library.ActiveTab = tab
	end

	function tab:AddSlider(options)
		options = options or {}
		local min = options.Min or 0
		local max = options.Max or 100
		local value = options.Default or min
		local callback = options.Callback or function() end

		local holder = Instance.new("Frame")
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.Size = UDim2.new(1, 0, 0, 32)
		holder.Parent = section

		local label = makeLabel(holder, options.Text or "Slider", 11, UDim2.new(0, 0, 0, -3), TEXT)
		label.Size = UDim2.new(1, 0, 0, 15)

		local track = Instance.new("TextButton")
		track.AutoButtonColor = false
		track.Text = ""
		track.BackgroundColor3 = Color3.fromRGB(28, 29, 39)
		track.BorderSizePixel = 0
		track.Position = UDim2.new(0, 0, 0, 18)
		track.Size = UDim2.new(1, 0, 0, 15)
		track.Parent = holder
		addStroke(track, Color3.fromRGB(116, 83, 108), 1)

		local fill = Instance.new("Frame")
		fill.BackgroundColor3 = self.Library.Accent
		fill.BorderSizePixel = 0
		fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
		fill.Parent = track

		local dragging = false
		local function update(inputX)
			local percent = math.clamp((inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			value = math.floor(min + (max - min) * percent)
			fill.Size = UDim2.new(percent, 0, 1, 0)
			callback(value)
		end

		track.MouseButton1Down:Connect(function()
			dragging = true
			clickFlash(track, Color3.fromRGB(28, 29, 39))
		end)

		UserInputService.InputChanged:Connect(function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				update(input.Position.X)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end)

		return holder
	end

	function tab:AddToggle(options)
		options = options or {}
		local state = options.Default == true
		local callback = options.Callback or function() end

		local row = Instance.new("TextButton")
		row.AutoButtonColor = false
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Font = Enum.Font.Code
		row.Text = ""
		row.Size = UDim2.new(1, 0, 0, 17)
		row.Parent = section

		local box = Instance.new("Frame")
		box.BackgroundColor3 = state and self.Library.Accent or Color3.fromRGB(30, 31, 41)
		box.BorderSizePixel = 0
		box.Position = UDim2.new(0, 0, 0, 3)
		box.Size = UDim2.new(0, 10, 0, 10)
		box.Parent = row
		addStroke(box, STROKE)

		local label = makeLabel(row, options.Text or "Enable", 11, UDim2.new(0, 16, 0, 0), MUTED)
		label.Size = UDim2.new(1, -16, 1, 0)

		row.MouseButton1Click:Connect(function()
			state = not state
			box.BackgroundColor3 = state and self.Library.Accent or Color3.fromRGB(30, 31, 41)
			clickFlash(row, Color3.fromRGB(255, 255, 255))
			callback(state)
		end)

		return row
	end

	function tab:AddKeybind(options)
		options = options or {}
		local current = options.Default or Enum.KeyCode.Q
		local callback = options.Callback or function() end
		local listening = false

		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, 18)
		row.Parent = section

		local label = makeLabel(row, options.Text or "Keybind", 11, UDim2.new(0, 0, 0, 0), MUTED)
		label.Size = UDim2.new(1, -30, 1, 0)

		local key = makeButton(row, current.Name, 16)
		key.Position = UDim2.new(1, -20, 0, 1)
		key.Size = UDim2.new(0, 20, 0, 16)

		key.MouseButton1Click:Connect(function()
			listening = true
			key.Text = "..."
			clickFlash(key, PANEL)
		end)

		UserInputService.InputBegan:Connect(function(input, processed)
			if processed then
				return
			end

			if listening and input.KeyCode ~= Enum.KeyCode.Unknown then
				current = input.KeyCode
				key.Text = current.Name
				listening = false
				callback(current)
			elseif input.KeyCode == current then
				callback(current)
			end
		end)

		return row
	end

	function tab:AddDropdown(options)
		options = options or {}
		local items = options.Items or {}
		local index = 1
		local callback = options.Callback or function() end

		local button = makeButton(section, options.Text or (items[index] or "Dropdown"), 18)
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.Text = (items[index] or options.Text or "Dropdown") .. "                         +"

		button.MouseButton1Click:Connect(function()
			index += 1
			if index > #items then
				index = 1
			end

			local selected = items[index] or options.Text or "Dropdown"
			button.Text = selected .. "                         +"
			clickFlash(button, PANEL)
			callback(selected)
		end)

		return button
	end

	function tab:AddButton(options)
		options = options or {}
		local button = makeButton(section, options.Text or "Button", 18)
		button.MouseButton1Click:Connect(function()
			clickFlash(button, PANEL)
			(options.Callback or function() end)()
		end)
		return button
	end

	function tab:AddColorBox(options)
		options = options or {}
		local color = options.Default or Color3.fromRGB(255, 255, 255)
		local callback = options.Callback or function() end

		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, 18)
		row.Parent = section

		local label = makeLabel(row, options.Text or "Box Color", 11, UDim2.new(0, 0, 0, 0), MUTED)
		label.Size = UDim2.new(1, -28, 1, 0)

		local box = Instance.new("TextButton")
		box.AutoButtonColor = false
		box.BackgroundColor3 = color
		box.BorderSizePixel = 0
		box.Text = ""
		box.Position = UDim2.new(1, -20, 0, 4)
		box.Size = UDim2.new(0, 18, 0, 10)
		box.Parent = row
		addStroke(box, STROKE)

		box.MouseButton1Click:Connect(function()
			color = color == Color3.fromRGB(255, 255, 255) and self.Library.Accent or Color3.fromRGB(255, 255, 255)
			box.BackgroundColor3 = color
			clickFlash(box, color)
			callback(color)
		end)

		return row
	end

	tab.Library = self
	self.Tabs[name] = tab

	tabButton.MouseButton1Click:Connect(function()
		clickFlash(tabButton, tabButton.BackgroundColor3)
		tab:Show()
	end)

	if not self.ActiveTab then
		tab:Show()
	end

	return tab
end

return Library

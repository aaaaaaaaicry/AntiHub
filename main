end

local function buildMisc()
	local page = makePage("Misc")

	local config = section(page.left, "Config", 132, 1)
	createToggle(config, "watermark", "Show watermark", true, false, function(value)
		applyRuntimeSetting("watermark", value)
	end)
	createToggle(config, "keybinds", "Keybind list", false, false, function(value)
		applyRuntimeSetting("keybinds", value)
	end)
	createToggle(config, "notifications", "Notifications", true, false, function(value)
		applyRuntimeSetting("notifications", value)
	end)
	createSlider(config, "volume", "Notification volume", 0, 100, 35, "%")

	local colors = section(page.left, "Accent", 64, 2)
	createColorPicker(colors, "misc accent", state.accent)

	local dropdowns = section(page.right, "Theme", 72, 1)
	createDropdown(dropdowns, "theme", "Theme", {
		"Red",
		"Crimson",
		"Steel",
		"Moss",
		"Rose",
	}, "Red", function(value)
		applyRuntimeSetting("theme", value)
	end)

	local binds = section(page.right, "Keybinds", 72, 2)
	createKeyPicker(binds, "bind", "Menu Bind", "RightShift", function(value)
		applyRuntimeSetting("bind", value)
	end)

	local actions = section(page.right, "Config actions", 72, 3)
	createButton(actions, "Save Config", nil, function()
		saveConfig()
	end)
	createButton(actions, "Load Config", nil, function()
		loadConfig()
	end)
end

local AntiHub = {
	state = state,
	theme = theme,
	pages = pages,
	tabs = tabs,
	window = window,
	pageHost = pageHost,
	setAccent = updateAccent,
	saveConfig = saveConfig,
	loadConfig = loadConfig,
}

function AntiHub:Page(name)
	return makePage(name)
end

function AntiHub:Section(parent, title, height, order)
	return section(parent, title, height, order)
end

function AntiHub:Row(parent, height)
	return row(parent, height)
end

function AntiHub:Toggle(parent, key, label, default, showCog, callback)
	return createToggle(parent, key, label, default, showCog, callback)
end

function AntiHub:Slider(parent, key, label, min, max, default, suffix, callback)
	return createSlider(parent, key, label, min, max, default, suffix, callback)
end

function AntiHub:ColorPicker(parent, label, defaultColor)
	return createColorPicker(parent, label, defaultColor)
end

function AntiHub:Button(parent, text, widthScale, callback)
	return createButton(parent, text, widthScale, callback)
end

function AntiHub:Dropdown(parent, key, label, options, default, callback)
	return createDropdown(parent, key, label, options, default, callback)
end

function AntiHub:KeyPicker(parent, key, label, defaultKey, callback)
	return createKeyPicker(parent, key, label, defaultKey, callback)
end

function AntiHub:SetRuntimeSetting(key, value)
	return applyRuntimeSetting(key, value)
end

if typeof(getgenv) == "function" then
	getgenv().AntiHub = AntiHub
end

if typeof(getgenv) == "function" and typeof(getgenv().AntiHubExample) == "function" then
	getgenv().AntiHubExample(AntiHub)
else
	buildAimbot()
	buildVisuals()
	buildMisc()
end


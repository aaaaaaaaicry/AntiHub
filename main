-- Single-file Luau UI recreation.
-- Run as a LocalScript/executor script. It creates the UI immediately.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer

local function getLocalPlayerName()
	if not player then return "Player" end
	return player.DisplayName or player.Name or "Player"
end

local function getLocalPlayerHandle()
	if not player then return "@player" end
	return "@" .. tostring(player.Name or "player")
end

local function getGuiParent()
	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and hui then return hui end
	end
	if player then
		local playerGui = player:FindFirstChildOfClass("PlayerGui")
		if playerGui then return playerGui end
	end
	local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
	return ok and coreGui or nil
end

local guiParent = getGuiParent()
if not guiParent then return end

local existing = guiParent:FindFirstChild("Anti_Hub_UI")
if existing then existing:Destroy() end

local theme = {
	bg = Color3.fromRGB(16, 17, 17),
	window = Color3.fromRGB(19, 20, 20),
	topbar = Color3.fromRGB(13, 14, 14),
	panel = Color3.fromRGB(26, 27, 27),
	panel2 = Color3.fromRGB(31, 32, 32),
	panel3 = Color3.fromRGB(22, 23, 23),
	text = Color3.fromRGB(232, 233, 236),
	muted = Color3.fromRGB(154, 156, 164),
	dim = Color3.fromRGB(105, 108, 116),
	accent = Color3.fromRGB(225, 47, 55),
	accent2 = Color3.fromRGB(132, 42, 48),
	stroke = Color3.fromRGB(43, 44, 45),
	black = Color3.fromRGB(9, 10, 10),
}

local state = {
	accent = theme.accent,
	menuKey = Enum.KeyCode.RightShift,
	menuBind = "RightShift",
	tab = "Main",
	values = {},
	setters = {},
}

local accentUpdaters = {}
local runtime = {
	loadedConfig = nil,
	notificationHolder = nil,
	watermark = nil,
	keybindList = nil,
	watermarkTick = 0,
}

local function hasFileApi()
	return typeof(isfile) == "function" and typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(makefolder) == "function"
end

local function ensureFolder(path)
	if hasFileApi() and typeof(isfolder) == "function" and not isfolder(path) then
		pcall(makefolder, path)
	end
end

local configFolder = "AntiHub_UI"
local assetFolder = configFolder .. "/Assets"
local configPath = configFolder .. "/config.json"
local fontScale = 0.42
local customFontFace

local function uiTextSize(size)
	if customFontFace then
		return math.max(5, math.floor(size * fontScale + 0.5))
	end
	return size
end

local tabSymbols = {
	Main = "4391741881",
	Visuals = "1137376343",
	Misc = "123657916614517",
}

local function symbolToImage(symbol)
	symbol = tostring(symbol or "")
	if symbol == "" then return nil end
	if string.find(symbol, "rbxassetid://") == 1 then return symbol end
	if tonumber(symbol) then return "rbxassetid://" .. symbol end
	return nil
end

local function loadPixelFont()
	if typeof(Font) ~= "table" or typeof(Font.new) ~= "function" then return nil end
	if hasFileApi() and typeof(getcustomasset) == "function" then
		ensureFolder(configFolder)
		ensureFolder(assetFolder)
		local ttfPath = assetFolder .. "/PressStart2P-Regular.ttf"
		local jsonPath = assetFolder .. "/PressStart2P.json"
		if not isfile(ttfPath) then
			pcall(function()
				writefile(ttfPath, game:HttpGet("https://github.com/google/fonts/raw/main/ofl/pressstart2p/PressStart2P-Regular.ttf"))
			end)
		end
		if isfile(ttfPath) and not isfile(jsonPath) then
			local fontData = {
				name = "PressStart2P",
				faces = {{ name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(ttfPath) }},
			}
			pcall(function() writefile(jsonPath, HttpService:JSONEncode(fontData)) end)
		end
		if isfile(jsonPath) then
			local ok, font = pcall(function() return Font.new(getcustomasset(jsonPath)) end)
			if ok then return font end
		end
	end
	if typeof(Font.fromEnum) == "function" then
		local ok, font = pcall(Font.fromEnum, Enum.Font.Arcade)
		if ok then return font end
	end
	return nil
end

customFontFace = loadPixelFont()

local function onAccentChanged(callback)
	table.insert(accentUpdaters, callback)
end

local function tween(obj, time, props, style, direction)
	local info = TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function new(className, props, children)
	local object = Instance.new(className)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	if customFontFace and (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
		pcall(function()
			object.FontFace = customFontFace
			if object.TextSize and object.TextSize > 0 then
				object.TextSize = uiTextSize(object.TextSize)
			end
		end)
	end
	for _, child in ipairs(children or {}) do
		child.Parent = object
	end
	return object
end

local function corner(radius) return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) }) end
local function stroke(color, transparency, thickness) return new("UIStroke", { Color = color or theme.stroke, Transparency = transparency or 0.4, Thickness = thickness or 1 }) end
local function padding(left, right, top, bottom) return new("UIPadding", { PaddingLeft = UDim.new(0, left or 0), PaddingRight = UDim.new(0, right or left or 0), PaddingTop = UDim.new(0, top or 0), PaddingBottom = UDim.new(0, bottom or top or 0) }) end

local screenGui = new("ScreenGui", { Name = "Anti_Hub_UI", IgnoreGuiInset = true, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Global, Parent = guiParent })
local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = screenGui })

local function loadConfigData()
	if not hasFileApi() then return nil end
	ensureFolder(configFolder)
	if not isfile(configPath) then return nil end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(configPath)) end)
	return ok and data or nil
end

runtime.loadedConfig = loadConfigData()

local function notify(text, duration, color)
	if state.values.notifications == false and text ~= "Config loaded" then return end
	if not runtime.notificationHolder then
		runtime.notificationHolder = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, 0, 1, -18),
			Size = UDim2.fromOffset(420, 220),
			Parent = root,
		}, { new("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	end
	local card = new("CanvasGroup", {
		BackgroundColor3 = Color3.fromRGB(12, 12, 12),
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Size = UDim2.fromOffset(0, 28),
		Parent = runtime.notificationHolder,
	}, { stroke(Color3.fromRGB(68, 68, 68), 0.1, 1), padding(8, 8, 0, 0) })
	new("Frame", { BackgroundColor3 = color or state.accent, BorderSizePixel = 0, Position = UDim2.fromOffset(-8, 0), Size = UDim2.new(1, 16, 0, 2), Parent = card })
	new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Arcade,
		Position = UDim2.fromOffset(0, 3),
		Size = UDim2.new(1, 0, 1, -3),
		Text = text,
		TextColor3 = Color3.fromRGB(225, 225, 225),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = card,
	})
	tween(card, 0.25, { GroupTransparency = 0, Size = UDim2.fromOffset(math.clamp(#text * 9 + 28, 150, 390), 28) }, Enum.EasingStyle.Back)
	task.delay(duration or 2, function()
		if card.Parent then
			local out = tween(card, 0.2, { GroupTransparency = 1, Size = UDim2.fromOffset(0, 28) })
			out.Completed:Connect(function() if card.Parent then card:Destroy() end end)
		end
	end)
end

local function makeMiniWindow(name, position, width)
	local miniText = uiTextSize(12)
	local miniHeight = math.max(18, miniText + 14)
	local frame = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(12, 12, 12),
		BorderSizePixel = 2,
		BorderColor3 = Color3.fromRGB(0, 0, 0),
		Position = position,
		Size = UDim2.fromOffset(width, miniHeight),
		Visible = false,
		Parent = root,
	}, { stroke(Color3.fromRGB(68, 68, 68), 0.05, 1), padding(8, 8, 4, 4) })
	new("Frame", { BackgroundColor3 = state.accent, BorderSizePixel = 0, Position = UDim2.fromOffset(-8, -4), Size = UDim2.new(1, 16, 0, 2), Parent = frame })
	local label = new("TextLabel", { BackgroundTransparency = 1, Name = "Label", Size = UDim2.new(1, 0, 1, 0), Text = name, TextColor3 = Color3.fromRGB(210, 210, 210), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
	local dragging = false
	local dragStart, startPosition
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = frame.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	onAccentChanged(function() frame:FindFirstChildOfClass("Frame").BackgroundColor3 = state.accent end)
	return frame, label
end

local watermarkFrame, watermarkText = makeMiniWindow("Anti Hub", UDim2.fromOffset(20, 20), 270)
runtime.watermark = watermarkFrame

local keybindFrame, keybindText = makeMiniWindow("Keybinds", UDim2.new(0, 20, 0.5, -55), 185)
runtime.keybindList = keybindFrame
keybindFrame.Size = UDim2.fromOffset(185, math.max(46, uiTextSize(12) * 4 + 24))
keybindText.Size = UDim2.new(1, 0, 0, math.max(12, uiTextSize(12) + 5))
local keybindRows = new("TextLabel", {
	BackgroundTransparency = 1,
	Position = UDim2.fromOffset(0, math.max(16, uiTextSize(12) + 10)),
	Size = UDim2.new(1, 0, 1, -math.max(16, uiTextSize(12) + 10)),
	Text = "",
	TextColor3 = Color3.fromRGB(180, 180, 180),
	TextSize = 12,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	Parent = keybindFrame,
})

local function keyName(key) return state.menuBind or (key and key.Name) or "RightShift" end

local function inputMatchesMenuBind(input)
	local bind = state.menuBind or "RightShift"
	if input.KeyCode and input.KeyCode.Name == bind then return true end
	if input.UserInputType and input.UserInputType.Name == bind then return true end
	return false
end

local function updateKeybindList()
	keybindRows.Text = "( Toggle ) Menu - " .. keyName(state.menuKey) .. "\n( Toggle ) Watermark - UI\n( Toggle ) Notifications - UI"
end

local function setOverlayVisible(frame, visible)
	if not frame then return end
	if visible then
		frame.Visible = true
		frame.BackgroundTransparency = 1
		tween(frame, 0.18, { BackgroundTransparency = 0 })
	else
		local out = tween(frame, 0.15, { BackgroundTransparency = 1 })
		out.Completed:Connect(function() if frame.BackgroundTransparency >= 1 then frame.Visible = false end end)
	end
end

local updateAccent

local lastClock = os.clock()
local fps = 60
RunService.RenderStepped:Connect(function()
	local now = os.clock()
	fps = math.floor(1 / math.max(now - lastClock, 1 / 240) + 0.5)
	lastClock = now
	if watermarkFrame.Visible and now - runtime.watermarkTick > 0.35 then
		runtime.watermarkTick = now
		local username = player and player.Name or "player"
		watermarkText.Text = "Anti Hub | " .. username .. " | " .. tostring(fps) .. " fps"
	end
end)

local function applySetting(key, value)
	if state.setters[key] then state.setters[key](value, true) else state.values[key] = value end
end

local function applyRuntimeSetting(key, value)
	if key == "watermark" then
		setOverlayVisible(runtime.watermark, value)
	elseif key == "keybinds" then
		updateKeybindList()
		setOverlayVisible(runtime.keybindList, value)
	elseif key == "notifications" then
		if value then notify("Notifications enabled", 1.3) end
	elseif key == "bind" then
		local map = { RightShift = Enum.KeyCode.RightShift, Insert = Enum.KeyCode.Insert, Home = Enum.KeyCode.Home, Delete = Enum.KeyCode.Delete }
		state.menuBind = tostring(value or "RightShift")
		state.menuKey = map[value] or Enum.KeyCode.RightShift
		updateKeybindList()
	elseif key == "theme" then
		local themes = { Red = Color3.fromRGB(225, 47, 55), Crimson = Color3.fromRGB(185, 35, 52), Steel = Color3.fromRGB(116, 164, 204), Moss = Color3.fromRGB(117, 174, 129), Rose = Color3.fromRGB(196, 111, 128) }
		if updateAccent then updateAccent(themes[value] or state.accent) end
	end
end

local function registerSetter(key, setter)
	state.setters[key] = setter
	if runtime.loadedConfig and runtime.loadedConfig.values and runtime.loadedConfig.values[key] ~= nil then
		setter(runtime.loadedConfig.values[key], true)
	end
end

local function loadConfig(payload)
	payload = payload or loadConfigData() or runtime.loadedConfig
	if not payload then
		notify("No config found", 2, Color3.fromRGB(218, 170, 91))
		return false
	end
	runtime.loadedConfig = payload
	if payload.values then
		for key, value in pairs(payload.values) do applySetting(key, value) end
	end
	if payload.menuKey and (not payload.values or payload.values.bind == nil) then
		applyRuntimeSetting("bind", payload.menuKey)
	end
	if payload.accent and updateAccent then
		local ok, savedAccent = pcall(function() return Color3.fromHex(payload.accent) end)
		if ok and savedAccent then updateAccent(savedAccent) end
	end
	notify("Config loaded", 2, Color3.fromRGB(117, 174, 129))
	return true
end

local function saveConfig()
	local payload = { values = state.values, accent = state.accent:ToHex(), menuKey = state.menuBind or keyName(state.menuKey) }
	if hasFileApi() then
		ensureFolder(configFolder)
		local ok = pcall(function() writefile(configPath, HttpService:JSONEncode(payload)) end)
		if ok then
			notify("Config saved", 2, Color3.fromRGB(117, 174, 129))
			return true
		end
	end
	runtime.loadedConfig = payload
	notify("Config saved in memory", 2, Color3.fromRGB(218, 170, 91))
	return false
end

local window = new("CanvasGroup", {
	Name = "Window",
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundColor3 = theme.window,
	BorderSizePixel = 0,
	GroupTransparency = 1,
	Position = UDim2.fromScale(0.5, 0.53),
	Size = UDim2.fromOffset(690, 580),
	Parent = root,
}, { corner(5), stroke(Color3.fromRGB(6, 7, 7), 0.15, 1) })

local scale = new("UIScale", { Scale = 1, Parent = window })

local function updateScale()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local fit = math.min((viewport.X - 24) / 690, (viewport.Y - 24) / 580, 1)
	scale.Scale = math.max(fit, 0.66)
end

updateScale()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(updateScale)
RunService.RenderStepped:Connect(function() if workspace.CurrentCamera then updateScale() end end)

local topbar = new("Frame", { Name = "Topbar", BackgroundColor3 = theme.topbar, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 53), Parent = window }, {
	new("Frame", { BackgroundColor3 = theme.accent, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 2) }, { new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 52, 56)), ColorSequenceKeypoint.new(0.18, Color3.fromRGB(185, 190, 204)), ColorSequenceKeypoint.new(1, Color3.fromRGB(55, 56, 60)) }) }) }),
	new("Frame", { BackgroundColor3 = Color3.fromRGB(29, 30, 31), BackgroundTransparency = 0.5, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1) }),
})

local topIcons = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 11), Size = UDim2.fromOffset(140, 32), Parent = topbar }, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }) })

local function iconButton(symbol, order)
	local button = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = theme.panel, BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, LayoutOrder = order, Size = UDim2.fromOffset(28, 28), Text = symbol, TextColor3 = theme.dim, TextSize = 23, Parent = topIcons }, { corner(6) })
	button.MouseEnter:Connect(function() tween(button, 0.16, { BackgroundTransparency = 0.25, TextColor3 = theme.text }) end)
	button.MouseLeave:Connect(function() tween(button, 0.16, { BackgroundTransparency = 1, TextColor3 = theme.dim }) end)
	return button
end

iconButton("o", 1)
iconButton("*", 2)
iconButton("/", 3)

new("TextLabel", { AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.new(1, -16, 0, 15), Size = UDim2.fromOffset(130, 24), Text = "Anti Hub", TextColor3 = Color3.fromRGB(212, 213, 217), TextSize = 19, TextXAlignment = Enum.TextXAlignment.Right, Parent = topbar })

local header = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(18, 74), Size = UDim2.fromOffset(330, 60), Parent = window })
local titleLabel = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(320, 36), Text = "Main", TextColor3 = theme.text, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Left, Parent = header })
local subtitleLabel = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(1, 34), Size = UDim2.fromOffset(330, 19), Text = "Configuration Panel", TextColor3 = theme.dim, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = header })

local saveButton = new("TextButton", { AnchorPoint = Vector2.new(1, 0), AutoButtonColor = false, BackgroundColor3 = theme.panel, Font = Enum.Font.GothamMedium, Position = UDim2.new(1, -12, 0, 92), Size = UDim2.fromOffset(100, 36), Text = "", Parent = window }, { corner(6), stroke(theme.stroke, 0.55, 1) })
new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(15, 0), Size = UDim2.fromOffset(23, 36), Text = "[]", TextColor3 = Color3.fromRGB(206, 208, 213), TextSize = 17, Parent = saveButton })
local saveText = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(42, 0), Size = UDim2.fromOffset(48, 36), Text = "Save", TextColor3 = Color3.fromRGB(198, 200, 207), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = saveButton })

saveButton.MouseEnter:Connect(function() tween(saveButton, 0.16, { BackgroundColor3 = theme.panel2 }) end)
saveButton.MouseLeave:Connect(function() tween(saveButton, 0.16, { BackgroundColor3 = theme.panel }) end)
saveButton.MouseButton1Click:Connect(function()
	local savedToDisk = saveConfig()
	saveText.Text = savedToDisk and "Saved" or "Memory"
	tween(saveButton, 0.08, { Size = UDim2.fromOffset(96, 34) })
	task.delay(0.08, function() if saveButton.Parent then tween(saveButton, 0.15, { Size = UDim2.fromOffset(100, 36) }) end end)
	task.delay(0.9, function() if saveText.Parent then saveText.Text = "Save" end end)
end)

local pageHost = new("Frame", { Name = "PageHost", BackgroundTransparency = 1, ClipsDescendants = false, Position = UDim2.fromOffset(30, 154), Size = UDim2.fromOffset(630, 318), Parent = window })
local pages = {}
local tabs = {}

local function makePage(name)
	local page = new("CanvasGroup", { Name = name .. "Page", BackgroundTransparency = 1, GroupTransparency = name == "Main" and 0 or 1, Position = UDim2.fromOffset(name == "Main" and 0 or 14, 0), Size = UDim2.fromScale(1, 1), Visible = name == "Main", Parent = pageHost })
	local left = new("Frame", { Name = "Left", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(300, 318), Parent = page }, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local right = new("Frame", { Name = "Right", BackgroundTransparency = 1, Position = UDim2.fromOffset(330, 0), Size = UDim2.fromOffset(300, 318), Parent = page }, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	pages[name] = { page = page, left = left, right = right }
	return pages[name]
end

local function section(parent, title, height, order)
	local frame = new("Frame", { BackgroundTransparency = 1, LayoutOrder = order or 1, Size = UDim2.fromOffset(300, height), Parent = parent })
	new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(7, 0), Size = UDim2.fromOffset(220, 18), Text = string.upper(title), TextColor3 = Color3.fromRGB(168, 170, 177), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
	local body = new("Frame", { BackgroundColor3 = theme.panel3, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 17), Size = UDim2.new(1, 0, 1, -17), Parent = frame }, { corner(5), stroke(theme.stroke, 0.75, 1), padding(8, 8, 7, 7), new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }) })
	return body, frame
end

local function row(parent, height) return new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or 25), Parent = parent }) end

local function createToggle(parent, key, label, default, showCog, callback)
	state.values[key] = default
	local r = row(parent, 25)
	new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -80, 1, 0), Text = label, TextColor3 = Color3.fromRGB(212, 213, 218), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	if showCog then new("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.new(1, -54, 0.5, 0), Size = UDim2.fromOffset(18, 18), Text = "*", TextColor3 = Color3.fromRGB(214, 216, 222), TextSize = 18, Parent = r }) end
	local holder = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), AutoButtonColor = false, BackgroundColor3 = default and state.accent or Color3.fromRGB(58, 60, 64), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(38, 20), Text = "", Parent = r }, { corner(10) })
	local knob = new("Frame", { BackgroundColor3 = Color3.fromRGB(244, 245, 247), BorderSizePixel = 0, Position = default and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(16, 16), Parent = holder }, { corner(8) })
	local function update()
		local enabled = state.values[key]
		tween(holder, 0.18, { BackgroundColor3 = enabled and state.accent or Color3.fromRGB(58, 60, 64) })
		tween(knob, 0.18, { Position = enabled and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2) })
	end
	onAccentChanged(update)
	local function setValue(value)
		state.values[key] = value == true
		update()
		if callback then callback(state.values[key]) end
	end
	holder.MouseButton1Click:Connect(function() setValue(not state.values[key]) end)
	registerSetter(key, setValue)
	setValue(state.values[key])
	return holder
end

local function createSlider(parent, key, label, min, max, default, suffix, callback)
	state.values[key] = default
	local r = row(parent, 35)
	new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -76, 0, 17), Text = label, TextColor3 = Color3.fromRGB(210, 212, 217), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	local valueBox = new("TextLabel", { AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = theme.panel, BorderSizePixel = 0, Font = Enum.Font.GothamBold, Position = UDim2.new(1, -6, 0, 0), Size = UDim2.fromOffset(38, 25), TextColor3 = Color3.fromRGB(210, 212, 217), TextSize = 11, Parent = r }, { corner(4) })
	local track = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(16, 17, 17), BorderSizePixel = 0, Position = UDim2.fromOffset(4, 24), Size = UDim2.new(1, -74, 0, 3), Text = "", Parent = r })
	local fill = new("Frame", { BackgroundColor3 = state.accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = track })
	onAccentChanged(function() tween(fill, 0.18, { BackgroundColor3 = state.accent }) end)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(242, 243, 245), BorderSizePixel = 0, Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(15, 15), Parent = track }, { corner(8) })
	local dragging = false
	local function formatValue(value) local rounded = math.floor(value + 0.5) return suffix and (tostring(rounded) .. suffix) or tostring(rounded) end
	local function setValueFromAlpha(alpha, animate)
		alpha = math.clamp(alpha, 0, 1)
		local value = min + (max - min) * alpha
		state.values[key] = value
		valueBox.Text = formatValue(value)
		if animate then
			tween(fill, 0.14, { Size = UDim2.fromScale(alpha, 1) })
			tween(knob, 0.14, { Position = UDim2.fromScale(alpha, 0.5) })
		else
			fill.Size = UDim2.fromScale(alpha, 1)
			knob.Position = UDim2.fromScale(alpha, 0.5)
		end
		if callback then callback(state.values[key]) end
	end
	local function setValue(value) value = tonumber(value) or default value = math.clamp(value, min, max) setValueFromAlpha((value - min) / (max - min), true) end
	local function alphaFromInput(input) return (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1) end
	track.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true setValueFromAlpha(alphaFromInput(input), false) end end)
	UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setValueFromAlpha(alphaFromInput(input), false) end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
	registerSetter(key, setValue)
	setValue(state.values[key])
	return r
end

-- COLOR PICKER VERDADEIRO COM RGB SLIDERS
local activeColorPicker = nil

local function createColorPicker(parent, label, defaultColor)
	local r = row(parent, 55)
	
	new("TextLabel", { 
		BackgroundTransparency = 1, 
		Font = Enum.Font.GothamMedium, 
		Position = UDim2.fromOffset(4, 0), 
		Size = UDim2.new(1, -96, 0, 20), 
		Text = label, 
		TextColor3 = Color3.fromRGB(213, 214, 219), 
		TextSize = 13, 
		TextXAlignment = Enum.TextXAlignment.Left, 
		Parent = r 
	})
	
	local colorValue = defaultColor or Color3.fromRGB(255, 255, 255)
	
	local valueText = new("TextLabel", { 
		AnchorPoint = Vector2.new(1, 0), 
		BackgroundColor3 = theme.panel, 
		BorderSizePixel = 0, 
		Font = Enum.Font.GothamMedium, 
		Position = UDim2.new(1, -41, 0, 0), 
		Size = UDim2.fromOffset(61, 22), 
		Text = "#" .. colorValue:ToHex():lower(), 
		TextColor3 = Color3.fromRGB(210, 212, 218), 
		TextSize = 11, 
		Parent = r 
	}, { corner(4) })
	
	local swatch = new("TextButton", { 
		AnchorPoint = Vector2.new(1, 0.5), 
		AutoButtonColor = false, 
		BackgroundColor3 = colorValue, 
		BorderSizePixel = 0, 
		Position = UDim2.new(1, -7, 0.5, 0), 
		Size = UDim2.fromOffset(22, 22), 
		Text = "", 
		Parent = r 
	}, { corner(4), stroke(Color3.fromRGB(220, 222, 227), 0.65, 1) })
	
	-- Painel do ColorPicker
	local pickerPanel = new("Frame", {
		BackgroundColor3 = theme.panel2,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 0, 110),
		Visible = false,
		Parent = r,
	}, { corner(4), stroke(theme.stroke, 0.55, 1), padding(8, 8, 8, 8) })
	
	-- Slider R
	local rFrame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 25), Parent = pickerPanel })
	new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(20, 25), Text = "R", TextColor3 = Color3.fromRGB(255, 80, 80), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = rFrame })
	local rTrack = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(40, 40, 40), BorderSizePixel = 0, Position = UDim2.fromOffset(25, 10), Size = UDim2.new(1, -95, 0, 3), Text = "", Parent = rFrame })
	local rFill = new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 80, 80), BorderSizePixel = 0, Size = UDim2.fromScale(colorValue.R, 1), Parent = rTrack })
	local rKnob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Position = UDim2.fromScale(colorValue.R, 0.5), Size = UDim2.fromOffset(10, 10), Parent = rTrack }, { corner(5) })
	local rValue = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.new(1, -30, 0, 0), Size = UDim2.fromOffset(30, 25), Text = tostring(math.floor(colorValue.R * 255)), TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, Parent = rFrame })
	
	-- Slider G
	local gFrame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 25), Parent = pickerPanel })
	new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(20, 25), Text = "G", TextColor3 = Color3.fromRGB(80, 255, 80), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = gFrame })
	local gTrack = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(40, 40, 40), BorderSizePixel = 0, Position = UDim2.fromOffset(25, 10), Size = UDim2.new(1, -95, 0, 3), Text = "", Parent = gFrame })
	local gFill = new("Frame", { BackgroundColor3 = Color3.fromRGB(80, 255, 80), BorderSizePixel = 0, Size = UDim2.fromScale(colorValue.G, 1), Parent = gTrack })
	local gKnob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Position = UDim2.fromScale(colorValue.G, 0.5), Size = UDim2.fromOffset(10, 10), Parent = gTrack }, { corner(5) })
	local gValue = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.new(1, -30, 0, 0), Size = UDim2.fromOffset(30, 25), Text = tostring(math.floor(colorValue.G * 255)), TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, Parent = gFrame })
	
	-- Slider B
	local bFrame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 25), Parent = pickerPanel })
	new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(20, 25), Text = "B", TextColor3 = Color3.fromRGB(80, 80, 255), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = bFrame })
	local bTrack = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(40, 40, 40), BorderSizePixel = 0, Position = UDim2.fromOffset(25, 10), Size = UDim2.new(1, -95, 0, 3), Text = "", Parent = bFrame })
	local bFill = new("Frame", { BackgroundColor3 = Color3.fromRGB(80, 80, 255), BorderSizePixel = 0, Size = UDim2.fromScale(colorValue.B, 1), Parent = bTrack })
	local bKnob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Position = UDim2.fromScale(colorValue.B, 0.5), Size = UDim2.fromOffset(10, 10), Parent = bTrack }, { corner(5) })
	local bValue = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.new(1, -30, 0, 0), Size = UDim2.fromOffset(30, 25), Text = tostring(math.floor(colorValue.B * 255)), TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, Parent = bFrame })
	
	local draggingR = false
	local draggingG = false
	local draggingB = false
	
	local function updateColor()
		local newColor = Color3.new(colorValue.R, colorValue.G, colorValue.B)
		swatch.BackgroundColor3 = newColor
		valueText.Text = "#" .. newColor:ToHex():lower()
	end
	
	local function setR(value)
		value = math.clamp(value, 0, 1)
		colorValue = Color3.new(value, colorValue.G, colorValue.B)
		rFill.Size = UDim2.fromScale(value, 1)
		rKnob.Position = UDim2.fromScale(value, 0.5)
		rValue.Text = tostring(math.floor(value * 255))
		updateColor()
	end
	
	local function setG(value)
		value = math.clamp(value, 0, 1)
		colorValue = Color3.new(colorValue.R, value, colorValue.B)
		gFill.Size = UDim2.fromScale(value, 1)
		gKnob.Position = UDim2.fromScale(value, 0.5)
		gValue.Text = tostring(math.floor(value * 255))
		updateColor()
	end
	
	local function setB(value)
		value = math.clamp(value, 0, 1)
		colorValue = Color3.new(colorValue.R, colorValue.G, value)
		bFill.Size = UDim2.fromScale(value, 1)
		bKnob.Position = UDim2.fromScale(value, 0.5)
		bValue.Text = tostring(math.floor(value * 255))
		updateColor()
	end
	
	local function alphaFromInput(track, input)
		return (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
	end
	
	rTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingR = true
			setR(alphaFromInput(rTrack, input))
		end
	end)
	gTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingG = true
			setG(alphaFromInput(gTrack, input))
		end
	end)
	bTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingB = true
			setB(alphaFromInput(bTrack, input))
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if draggingR and input.UserInputType == Enum.UserInputType.MouseMovement then
			setR(alphaFromInput(rTrack, input))
		elseif draggingG and input.UserInputType == Enum.UserInputType.MouseMovement then
			setG(alphaFromInput(gTrack, input))
		elseif draggingB and input.UserInputType == Enum.UserInputType.MouseMovement then
			setB(alphaFromInput(bTrack, input))
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingR = false
			draggingG = false
			draggingB = false
		end
	end)
	
	swatch.MouseButton1Click:Connect(function()
		if activeColorPicker and activeColorPicker ~= pickerPanel then
			activeColorPicker.Visible = false
		end
		pickerPanel.Visible = not pickerPanel.Visible
		activeColorPicker = pickerPanel.Visible and pickerPanel or nil
	end)
	
	return r
end

local function createButton(parent, text, widthScale, callback)
	local b = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = theme.panel, BorderSizePixel = 0, Font = Enum.Font.GothamBold, Size = widthScale and UDim2.new(widthScale, -3, 0, 29) or UDim2.new(1, 0, 0, 29), Text = text, TextColor3 = Color3.fromRGB(228, 229, 233), TextSize = 12, Parent = parent }, { corner(3), stroke(theme.stroke, 0.85, 1) })
	b.MouseEnter:Connect(function() tween(b, 0.15, { BackgroundColor3 = theme.panel2, TextColor3 = Color3.fromRGB(255, 255, 255) }) end)
	b.MouseLeave:Connect(function() tween(b, 0.18, { BackgroundColor3 = theme.panel, TextColor3 = Color3.fromRGB(228, 229, 233) }) end)
	b.MouseButton1Down:Connect(function() tween(b, 0.08, { Size = widthScale and UDim2.new(widthScale, -7, 0, 27) or UDim2.new(1, -4, 0, 27) }) end)
	b.MouseButton1Up:Connect(function() tween(b, 0.12, { Size = widthScale and UDim2.new(widthScale, -3, 0, 29) or UDim2.new(1, 0, 0, 29) }) end)
	b.MouseButton1Click:Connect(function() if callback then callback() end end)
	return b
end

local openDropdown
local function createDropdown(parent, key, label, options, default, callback)
	state.values[key] = default or options[1]
	local r = row(parent, 31)
	r.ZIndex = 40
	new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(0.52, 0, 1, 0), Text = label, TextColor3 = Color3.fromRGB(205, 207, 212), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	local button = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), AutoButtonColor = false, BackgroundColor3 = theme.panel, BorderSizePixel = 0, Font = Enum.Font.GothamMedium, Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(142, 30), Text = "", ZIndex = 41, Parent = r }, { corner(4) })
	local selected = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -28, 1, 0), Text = state.values[key], TextColor3 = Color3.fromRGB(220, 222, 227), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 42, Parent = button })
	local arrow = new("TextLabel", { AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.new(1, -9, 0, 0), Size = UDim2.fromOffset(13, 30), Text = "v", TextColor3 = theme.dim, TextSize = 12, ZIndex = 42, Parent = button })
	local menu = new("CanvasGroup", { AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = theme.panel, BorderSizePixel = 0, GroupTransparency = 1, Position = UDim2.new(1, -4, 1, 1), Size = UDim2.fromOffset(142, 0), Visible = false, ZIndex = 200, Parent = r }, { corner(4), stroke(theme.stroke, 0.55, 1) })
	local list = new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })
	local dropdownData = {}
	local optionViews = {}
	local optionButtons = {}
	local function hasOption(value) for _, option in ipairs(options) do if option == value then return true end end return false end
	local function setValue(value)
		if not hasOption(value) then value = default or options[1] end
		state.values[key] = value
		selected.Text = value
		for optionName, view in pairs(optionViews) do
			local active = optionName == value
			tween(view.button, 0.12, { BackgroundColor3 = active and Color3.fromRGB(38, 24, 26) or theme.panel, TextColor3 = active and state.accent or Color3.fromRGB(219, 221, 226) })
			tween(view.marker, 0.12, { BackgroundTransparency = active and 0 or 1, Size = active and UDim2.fromOffset(3, 18) or UDim2.fromOffset(3, 4) })
		end
		if callback then callback(value) end
	end
	for index, option in ipairs(options) do
		local opt = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = theme.panel, BorderSizePixel = 0, Font = Enum.Font.GothamMedium, LayoutOrder = index, Size = UDim2.new(1, 0, 0, 28), Text = "  " .. option, TextColor3 = Color3.fromRGB(219, 221, 226), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 51, Parent = menu }, { padding(12, 8, 0, 0) })
		local marker = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = state.accent, BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 5, 0.5, 0), Size = UDim2.fromOffset(3, 4), ZIndex = 52, Parent = opt }, { corner(2) })
		optionViews[option] = { button = opt, marker = marker }
		table.insert(optionButtons, opt)
		onAccentChanged(function()
			marker.BackgroundColor3 = state.accent
			if state.values[key] == option then opt.TextColor3 = state.accent end
		end)
		opt.MouseEnter:Connect(function() if state.values[key] ~= option then tween(opt, 0.12, { BackgroundColor3 = Color3.fromRGB(39, 41, 43) }) end end)
		opt.MouseLeave:Connect(function() if state.values[key] ~= option then tween(opt, 0.16, { BackgroundColor3 = theme.panel }) end end)
		opt.MouseButton1Click:Connect(function() setValue(option) if dropdownData.close then dropdownData.close() end end)
	end
	local function open()
		if openDropdown and openDropdown ~= dropdownData and openDropdown.close then openDropdown.close() end
		openDropdown = dropdownData
		r.ZIndex = 190
		menu.ZIndex = 200
		for _, opt in ipairs(optionButtons) do
			opt.ZIndex = 201
			for _, item in ipairs(opt:GetDescendants()) do if item:IsA("GuiObject") then item.ZIndex = 202 end end
		end
		menu.Visible = true
		arrow.Text = "^"
		tween(menu, 0.18, { Size = UDim2.fromOffset(142, math.min(#options, 5) * 28), GroupTransparency = 0 })
	end
	local function close()
		arrow.Text = "v"
		local t = tween(menu, 0.14, { Size = UDim2.fromOffset(142, 0), GroupTransparency = 1 })
		t.Completed:Connect(function() if menu.GroupTransparency >= 1 then menu.Visible = false r.ZIndex = 40 end end)
	end
	dropdownData.close = close
	button.MouseButton1Click:Connect(function() if menu.Visible then close() else open() end end)
	registerSetter(key, setValue)
	setValue(state.values[key])
	return r
end

local function createKeyPicker(parent, key, label, defaultKey, callback)
	state.values[key] = defaultKey or "RightShift"
	local r = row(parent, 31)
	new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(0.52, 0, 1, 0), Text = label, TextColor3 = Color3.fromRGB(205, 207, 212), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	local button = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), AutoButtonColor = false, BackgroundColor3 = theme.panel, BorderSizePixel = 0, Font = Enum.Font.GothamMedium, Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(142, 30), Text = "", Parent = r }, { corner(4), stroke(theme.stroke, 0.8, 1) })
	local valueText = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = tostring(state.values[key]), TextColor3 = Color3.fromRGB(220, 222, 227), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Parent = button })
	local picking = false
	local inputConnection
	local function setValue(value)
		value = tostring(value or defaultKey or "RightShift")
		state.values[key] = value
		valueText.Text = value
		tween(button, 0.15, { BackgroundColor3 = theme.panel })
		tween(valueText, 0.15, { TextColor3 = Color3.fromRGB(220, 222, 227) })
		if callback then callback(value) end
	end
	local function stopPicking() picking = false if inputConnection then inputConnection:Disconnect() inputConnection = nil end end
	button.MouseButton1Click:Connect(function()
		if picking then stopPicking() setValue(state.values[key]) return end
		picking = true
		valueText.Text = "press key"
		tween(button, 0.15, { BackgroundColor3 = Color3.fromRGB(38, 24, 26) })
		tween(valueText, 0.15, { TextColor3 = state.accent })
		inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
			if processed then return end
			local chosen
			if input.UserInputType == Enum.UserInputType.Keyboard then chosen = input.KeyCode.Name
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then chosen = "MouseButton1"
			elseif input.UserInputType == Enum.UserInputType.MouseButton2 then chosen = "MouseButton2"
			elseif input.UserInputType == Enum.UserInputType.MouseButton3 then chosen = "MouseButton3" end
			if chosen then stopPicking() setValue(chosen) end
		end)
	end)
	button.MouseEnter:Connect(function() if not picking then tween(button, 0.12, { BackgroundColor3 = theme.panel2 }) end end)
	button.MouseLeave:Connect(function() if not picking then tween(button, 0.14, { BackgroundColor3 = theme.panel }) end end)
	onAccentChanged(function() if picking then valueText.TextColor3 = state.accent end end)
	registerSetter(key, setValue)
	setValue(state.values[key])
	return r
end

-- UI EXPOSED FUNCTIONS
local AntiHub = {
	state = state,
	theme = theme,
	pages = pages,
	tabs = tabs,
	window = window,
	pageHost = pageHost,
	saveConfig = saveConfig,
	loadConfig = loadConfig,
}

function AntiHub:Page(name) return makePage(name) end
function AntiHub:Section(parent, title, height, order) return section(parent, title, height, order) end
function AntiHub:Row(parent, height) return row(parent, height) end
function AntiHub:Toggle(parent, key, label, default, showCog, callback) return createToggle(parent, key, label, default, showCog, callback) end
function AntiHub:Slider(parent, key, label, min, max, default, suffix, callback) return createSlider(parent, key, label, min, max, default, suffix, callback) end
function AntiHub:ColorPicker(parent, label, defaultColor) return createColorPicker(parent, label, defaultColor) end
function AntiHub:Button(parent, text, widthScale, callback) return createButton(parent, text, widthScale, callback) end
function AntiHub:Dropdown(parent, key, label, options, default, callback) return createDropdown(parent, key, label, options, default, callback) end
function AntiHub:KeyPicker(parent, key, label, defaultKey, callback) return createKeyPicker(parent, key, label, defaultKey, callback) end
function AntiHub:SetRuntimeSetting(key, value) return applyRuntimeSetting(key, value) end

if typeof(getgenv) == "function" then getgenv().AntiHub = AntiHub end

-- Build default UI
local main = AntiHub:Page("Main")
local combat = AntiHub:Section(main.left, "Combat", 140, 1)
AntiHub:Toggle(combat, "aimbot", "Aimbot", true, true)
AntiHub:Toggle(combat, "silent", "Silent Aim", true, false)

local colors = AntiHub:Section(main.left, "Colors", 80, 2)
AntiHub:ColorPicker(colors, "Aimbot Color", Color3.fromRGB(255, 0, 0))
AntiHub:ColorPicker(colors, "ESP Color", Color3.fromRGB(0, 255, 0))

local visuals = AntiHub:Page("Visuals")
local esp = AntiHub:Section(visuals.left, "ESP", 100, 1)
AntiHub:Toggle(esp, "esp", "ESP", true, false)

local espColors = AntiHub:Section(visuals.left, "Colors", 80, 2)
AntiHub:ColorPicker(espColors, "Box Color", Color3.fromRGB(0, 150, 255))

local misc = AntiHub:Page("Misc")
local config = AntiHub:Section(misc.left, "Config", 120, 1)
AntiHub:Toggle(config, "watermark", "Watermark", true, false, function(v) AntiHub:SetRuntimeSetting("watermark", v) end)
AntiHub:Button(config, "Save", nil, function() AntiHub.saveConfig() end)
AntiHub:Button(config, "Load", nil, function() AntiHub.loadConfig() end)


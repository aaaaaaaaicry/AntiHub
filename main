-- Anti hub - ready to execute UI
-- Paste this whole file into your executor.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local delayCall = task and task.delay or function(seconds, callback)
	spawn(function()
		wait(seconds)
		callback()
	end)
end

local function getUiParent()
	local ok, ui = pcall(function()
		return gethui()
	end)

	if ok and ui then
		return ui
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)

	if okCore and coreGui then
		return coreGui
	end

	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local colors = {
	main = rgb(35, 36, 47),
	top = rgb(31, 32, 42),
	side = rgb(30, 31, 42),
	panel = rgb(36, 37, 49),
	panelDark = rgb(29, 30, 40),
	line = rgb(50, 51, 67),
	lineSoft = rgb(69, 59, 76),
	text = rgb(218, 219, 228),
	muted = rgb(147, 148, 160),
	red = rgb(185, 38, 45),
	redLight = rgb(235, 78, 86),
	white = rgb(245, 245, 248)
}

local old = getUiParent():FindFirstChild("AntiHubReadyUI")
if old then
	old:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "AntiHubReadyUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = getUiParent()

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or colors.line
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.Parent = parent
	return s
end

local function label(parent, text, x, y, w, h, size, color, align)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	t.Font = Enum.Font.Code
	t.Text = text or ""
	t.TextColor3 = color or colors.text
	t.TextSize = size or 12
	t.TextXAlignment = align or Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.Position = UDim2.new(0, x or 0, 0, y or 0)
	t.Size = UDim2.new(0, w or 100, 0, h or 18)
	t.Parent = parent
	return t
end

local function button(parent, text, x, y, w, h)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundColor3 = colors.panelDark
	b.BorderSizePixel = 0
	b.Font = Enum.Font.Code
	b.Text = text or ""
	b.TextColor3 = colors.text
	b.TextSize = 12
	b.Position = UDim2.new(0, x or 0, 0, y or 0)
	b.Size = UDim2.new(0, w or 100, 0, h or 18)
	b.Parent = parent
	stroke(b, colors.line)
	return b
end

local function flash(obj, baseColor)
	local basePos = obj.Position
	local base = baseColor or obj.BackgroundColor3
	local baseTrans = obj.BackgroundTransparency
	local flashTrans = baseTrans

	if flashTrans > 0.85 then
		flashTrans = 0.65
	end

	TweenService:Create(obj, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = basePos + UDim2.new(0, 7, 0, 0),
		BackgroundColor3 = colors.redLight,
		BackgroundTransparency = flashTrans
	}):Play()

	delayCall(0.1, function()
		if obj and obj.Parent then
			TweenService:Create(obj, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = basePos,
				BackgroundColor3 = base,
				BackgroundTransparency = baseTrans
			}):Play()
		end
	end)
end


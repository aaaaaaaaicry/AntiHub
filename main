-- Recriar botão flutuante
local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ToggleUIButton"
ToggleButton.Size = UDim2.new(0, 50, 0, 50)
ToggleButton.Position = UDim2.new(0.85, 0, 0.85, 0)
ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
ToggleButton.BackgroundTransparency = 0.3
ToggleButton.Text = "≡"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 25
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.Parent = game.CoreGui

local ToggleCorner = Instance.new("UICorner")
ToggleCorner.CornerRadius = UDim.new(0.5, 0)
ToggleCorner.Parent = ToggleButton

local uiVisible = false
local ui = game.CoreGui:FindFirstChild("ui")

ToggleButton.MouseButton1Click:Connect(function()
    if ui then
        local main = ui:FindFirstChild("Main")
        if main then
            if not uiVisible then
                ui.Enabled = true
                main:TweenSize(UDim2.new(0, 560, 0, 319), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.4, true)
                ToggleButton.Text = "≡"
                ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                uiVisible = true
            else
                main:TweenSize(UDim2.new(0, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.4, true)
                task.wait(0.4)
                ui.Enabled = false
                ToggleButton.Text = "▶"
                ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                uiVisible = false
            end
        end
    end
end)

-- Fazer o botão ser arrastável
local dragging = false
local dragStart = nil
local startPos = nil

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleButton.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        local newX = math.clamp(startPos.X.Scale + (delta.X / game.CoreGui.AbsoluteSize.X), 0, 0.95)
        local newY = math.clamp(startPos.Y.Scale + (delta.Y / game.CoreGui.AbsoluteSize.Y), 0, 0.95)
        ToggleButton.Position = UDim2.new(newX, 0, newY, 0)
    end
end)

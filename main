AntiHub:ColorPicker(miscColors, "UI Accent", Color3.fromRGB(225, 47, 55))

if runtime.loadedConfig and runtime.loadedConfig.accent then
	local ok, savedAccent = pcall(function() return Color3.fromHex(runtime.loadedConfig.accent) end)
	if ok and savedAccent then
		state.accent = savedAccent
	end
end

updateKeybindList()

local bottom = new("Frame", { Name = "BottomBar", AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = Color3.fromRGB(21, 22, 22), BorderSizePixel = 0, Position = UDim2.new(0.5, 0, 1, -9), Size = UDim2.fromOffset(622, 64), Parent = window }, { corner(5), stroke(state.accent, 0.2, 1) })

local nav = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(25, 6), Size = UDim2.fromOffset(236, 52), Parent = bottom }, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })

local tabMeta = {
	Main = { icon = tabSymbols.Main, subtitle = "Main Configuration" },
	Visuals = { icon = tabSymbols.Visuals, subtitle = "Visual Settings" },
	Misc = { icon = tabSymbols.Misc, subtitle = "Miscellaneous" },
}

local function setTab(name)
	if state.tab == name then return end
	local oldName = state.tab
	state.tab = name
	titleLabel.Text = name
	subtitleLabel.Text = tabMeta[name].subtitle
	for tabName, button in pairs(tabs) do
		local active = tabName == name
		tween(button.frame, 0.18, { BackgroundColor3 = active and theme.black or Color3.fromRGB(21, 22, 22), BackgroundTransparency = active and 0 or 1 })
		tween(button.text, 0.18, { TextColor3 = active and theme.text or theme.dim })
		tween(button.iconText, 0.18, { TextColor3 = active and theme.text or theme.dim })
		tween(button.iconImage, 0.18, { ImageColor3 = active and theme.text or theme.dim })
	end
	local old = pages[oldName] and pages[oldName].page
	local nextPage = pages[name] and pages[name].page
	if old then
		local oldTween = tween(old, 0.15, { GroupTransparency = 1, Position = UDim2.fromOffset(-12, 0) })
		oldTween.Completed:Connect(function() if state.tab ~= oldName and old.Parent then old.Visible = false end end)
	end
	if nextPage then
		nextPage.Visible = true
		nextPage.Position = UDim2.fromOffset(14, 0)
		nextPage.GroupTransparency = 1
		tween(nextPage, 0.22, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
	end
end

local function createTab(name, order)
	local active = name == state.tab
	local button = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = active and theme.black or Color3.fromRGB(21, 22, 22), BackgroundTransparency = active and 0 or 1, BorderSizePixel = 0, LayoutOrder = order, Size = UDim2.fromOffset(72, 52), Text = "", Parent = nav }, { corner(2) })
	local image = symbolToImage(tabMeta[name].icon)
	local iconImage = new("ImageLabel", { BackgroundTransparency = 1, Image = image or "", ImageColor3 = active and theme.text or theme.dim, Position = UDim2.fromOffset(26, 8), ScaleType = Enum.ScaleType.Fit, Size = UDim2.fromOffset(20, 20), Visible = image ~= nil, Parent = button })
	local iconText = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(0, 7), Size = UDim2.new(1, 0, 0, 19), Text = image and "" or tabMeta[name].icon, TextColor3 = active and theme.text or theme.dim, TextSize = 20, Visible = image == nil, Parent = button })
	local text = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 15), Text = name, TextColor3 = active and theme.text or theme.dim, TextSize = 11, Parent = button })
	tabs[name] = { frame = button, iconText = iconText, iconImage = iconImage, text = text }
	button.MouseEnter:Connect(function() if state.tab ~= name then tween(button, 0.14, { BackgroundTransparency = 0.55 }) end end)
	button.MouseLeave:Connect(function() if state.tab ~= name then tween(button, 0.16, { BackgroundTransparency = 1 }) end end)
	button.MouseButton1Click:Connect(function() setTab(name) end)
end

createTab("Main", 1)
createTab("Visuals", 2)
createTab("Misc", 3)

new("Frame", { BackgroundColor3 = Color3.fromRGB(34, 35, 36), BorderSizePixel = 0, Position = UDim2.new(1, -172, 0, 0), Size = UDim2.fromOffset(1, 64), Parent = bottom })

local profile = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(145, 44), Parent = bottom })
local avatarBack = new("Frame", { BackgroundColor3 = theme.black, BorderSizePixel = 0, Position = UDim2.fromOffset(2, 4), Size = UDim2.fromOffset(37, 37), Parent = profile }, { corner(19), stroke(theme.stroke, 0.55, 1) })
local avatar = new("ImageLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(3, 5), Size = UDim2.fromOffset(35, 35), Image = "", ScaleType = Enum.ScaleType.Crop, Parent = profile }, { corner(18) })

task.spawn(function()
	if player then
		local ok, image = pcall(function() return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) end)
		if ok and image and avatar.Parent then avatar.Image = image
		elseif avatarBack.Parent then avatarBack.BackgroundColor3 = state.accent end
	end
end)

new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(50, 5), Size = UDim2.fromOffset(86, 17), Text = getLocalPlayerName(), TextColor3 = theme.text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = profile })
new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(50, 22), Size = UDim2.fromOffset(95, 14), Text = getLocalPlayerHandle(), TextColor3 = theme.dim, TextSize = 9, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = profile })

local draggingWindow = false
local dragStart, startPosition

topbar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = true
		dragStart = input.Position
		startPosition = window.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingWindow and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		window.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = false
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if inputMatchesMenuBind(input) then
		local target = window.GroupTransparency == 0 and 1 or 0
		if target == 0 then window.Visible = true end
		local t = tween(window, 0.2, { GroupTransparency = target })
		t.Completed:Connect(function() if target == 1 and window.Parent then window.Visible = false end end)
	end
end)

window.Size = UDim2.fromOffset(670, 560)
tween(window, 0.35, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(690, 580) }, Enum.EasingStyle.Back)

-- Single-file Luau UI recreation.
-- Run as a LocalScript/executor script. It creates the UI immediately.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer

local function getLocalPlayerName()
	if not player then
		return "Player"
	end

	return player.DisplayName or player.Name or "Player"
end

local function getLocalPlayerHandle()
	if not player then
		return "@player"
	end

	return "@" .. tostring(player.Name or "player")
end

local function getGuiParent()
	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and hui then
			return hui
		end
	end

	if player then
		local playerGui = player:FindFirstChildOfClass("PlayerGui")
		if playerGui then
			return playerGui
		end
	end

	local ok, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)

	return ok and coreGui or nil
end

local guiParent = getGuiParent()
if not guiParent then
	return
end

local existing = guiParent:FindFirstChild("Anti_Hub_UI") or guiParent:FindFirstChild("SK22T_Recreated_UI")
if existing then
	existing:Destroy()
end

local theme = {
	bg = Color3.fromRGB(16, 17, 17),
	window = Color3.fromRGB(19, 20, 20),
	topbar = Color3.fromRGB(13, 14, 14),
	panel = Color3.fromRGB(26, 27, 27),
	panel2 = Color3.fromRGB(31, 32, 32),
	panel3 = Color3.fromRGB(22, 23, 23),
	text = Color3.fromRGB(232, 233, 236),
	muted = Color3.fromRGB(154, 156, 164),
	dim = Color3.fromRGB(105, 108, 116),
	accent = Color3.fromRGB(225, 47, 55),
	accent2 = Color3.fromRGB(132, 42, 48),
	stroke = Color3.fromRGB(43, 44, 45),
	black = Color3.fromRGB(9, 10, 10),
}

local state = {
	accent = theme.accent,
	menuKey = Enum.KeyCode.RightShift,
	menuBind = "RightShift",
	tab = "Aimbot",
	values = {},
	setters = {},
}

local accentUpdaters = {}
local runtime = {
	loadedConfig = nil,
	notificationHolder = nil,
	watermark = nil,
	keybindList = nil,
	watermarkTick = 0,
}

local function hasFileApi()
	return typeof(isfile) == "function"
		and typeof(writefile) == "function"
		and typeof(readfile) == "function"
		and typeof(makefolder) == "function"
end

local function ensureFolder(path)
	if hasFileApi() and typeof(isfolder) == "function" and not isfolder(path) then
		pcall(makefolder, path)
	end
end

local configFolder = "AntiHub_UI"
local assetFolder = configFolder .. "/Assets"
local configPath = configFolder .. "/config.json"
local fontScale = 0.42
local customFontFace

local function uiTextSize(size)
	if customFontFace then
		return math.max(5, math.floor(size * fontScale + 0.5))
	end
	return size
end

local tabSymbols = {
	-- Use text like "A" or an asset id like "rbxassetid://123456789".
	Aimbot = "A",
	Visuals = "V",
	Misc = "M",
}

local function symbolToImage(symbol)
	symbol = tostring(symbol or "")
	if symbol == "" then
		return nil
	end
	if string.find(symbol, "rbxassetid://") == 1 then
		return symbol
	end
	if tonumber(symbol) then
		return "rbxassetid://" .. symbol
	end
	return nil
end

local function loadPixelFont()
	if typeof(Font) ~= "table" or typeof(Font.new) ~= "function" then
		return nil
	end

	if hasFileApi() and typeof(getcustomasset) == "function" then
		ensureFolder(configFolder)
		ensureFolder(assetFolder)

		local ttfPath = assetFolder .. "/PressStart2P-Regular.ttf"
		local jsonPath = assetFolder .. "/PressStart2P.json"

		if not isfile(ttfPath) then
			pcall(function()
				writefile(ttfPath, game:HttpGet("https://github.com/google/fonts/raw/main/ofl/pressstart2p/PressStart2P-Regular.ttf"))
			end)
		end

		if isfile(ttfPath) and not isfile(jsonPath) then
			local fontData = {
				name = "PressStart2P",
				faces = {
					{
						name = "Regular",
						weight = 400,
						style = "normal",
						assetId = getcustomasset(ttfPath),
					},
				},
			}
			pcall(function()
				writefile(jsonPath, HttpService:JSONEncode(fontData))
			end)
		end

		if isfile(jsonPath) then
			local ok, font = pcall(function()
				return Font.new(getcustomasset(jsonPath))
			end)
			if ok then
				return font
			end
		end
	end

	if typeof(Font.fromEnum) == "function" then
		local ok, font = pcall(Font.fromEnum, Enum.Font.Arcade)
		if ok then
			return font
		end
	end

	return nil
end

customFontFace = loadPixelFont()

local function onAccentChanged(callback)
	table.insert(accentUpdaters, callback)
end

local function tween(obj, time, props, style, direction)
	local info = TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function new(className, props, children)
	local object = Instance.new(className)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	if customFontFace and (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
		pcall(function()
			object.FontFace = customFontFace
			if object.TextSize and object.TextSize > 0 then
				object.TextSize = uiTextSize(object.TextSize)
			end
		end)
	end
	for _, child in ipairs(children or {}) do
		child.Parent = object
	end
	return object
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

local function stroke(color, transparency, thickness)
	return new("UIStroke", {
		Color = color or theme.stroke,
		Transparency = transparency or 0.4,
		Thickness = thickness or 1,
	})
end

local function padding(left, right, top, bottom)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or top or 0),
	})
end

local screenGui = new("ScreenGui", {
	Name = "Anti_Hub_UI",
	IgnoreGuiInset = true,
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Global,
	Parent = guiParent,
})

local root = new("Frame", {
	Name = "Root",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	Parent = screenGui,
})

local function loadConfigData()
	if not hasFileApi() then
		return nil
	end

	ensureFolder(configFolder)
	if not isfile(configPath) then
		return nil
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(configPath))
	end)

	return ok and data or nil
end

runtime.loadedConfig = loadConfigData()

local function notify(text, duration, color)
	if state.values.notifications == false and text ~= "Config loaded" then
		return
	end

	if not runtime.notificationHolder then
		runtime.notificationHolder = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, 0, 1, -18),
			Size = UDim2.fromOffset(420, 220),
			Parent = root,
		}, {
			new("UIListLayout", {
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Bottom,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end

	local card = new("CanvasGroup", {
		BackgroundColor3 = Color3.fromRGB(12, 12, 12),
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Size = UDim2.fromOffset(0, 28),
		Parent = runtime.notificationHolder,
	}, {
		stroke(Color3.fromRGB(68, 68, 68), 0.1, 1),
		padding(8, 8, 0, 0),
	})

	new("Frame", {
		BackgroundColor3 = color or state.accent,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(-8, 0),
		Size = UDim2.new(1, 16, 0, 2),
		Parent = card,
	})

	new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Arcade,
		Position = UDim2.fromOffset(0, 3),
		Size = UDim2.new(1, 0, 1, -3),
		Text = text,
		TextColor3 = Color3.fromRGB(225, 225, 225),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = card,
	})

	tween(card, 0.25, { GroupTransparency = 0, Size = UDim2.fromOffset(math.clamp(#text * 9 + 28, 150, 390), 28) }, Enum.EasingStyle.Back)
	task.delay(duration or 2, function()
		if card.Parent then
			local out = tween(card, 0.2, { GroupTransparency = 1, Size = UDim2.fromOffset(0, 28) })
			out.Completed:Connect(function()
				if card.Parent then
					card:Destroy()
				end
			end)
		end
	end)
end

local function makeMiniWindow(name, position, width)
	local miniText = uiTextSize(12)
	local miniHeight = math.max(18, miniText + 14)

	local frame = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(12, 12, 12),
		BorderSizePixel = 2,
		BorderColor3 = Color3.fromRGB(0, 0, 0),
		Position = position,
		Size = UDim2.fromOffset(width, miniHeight),
		Visible = false,
		Parent = root,
	}, {
		stroke(Color3.fromRGB(68, 68, 68), 0.05, 1),
		padding(8, 8, 4, 4),
	})

	new("Frame", {
		BackgroundColor3 = state.accent,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(-8, -4),
		Size = UDim2.new(1, 16, 0, 2),
		Parent = frame,
	})

	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Name = "Label",
		Size = UDim2.new(1, 0, 1, 0),
		Text = name,
		TextColor3 = Color3.fromRGB(210, 210, 210),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})

	local dragging = false
	local dragStart
	local startPosition

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = frame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	onAccentChanged(function()
		frame:FindFirstChildOfClass("Frame").BackgroundColor3 = state.accent
	end)

	return frame, label
end

local watermarkFrame, watermarkText = makeMiniWindow("Anti Hub", UDim2.fromOffset(20, 20), 270)
runtime.watermark = watermarkFrame

local keybindFrame, keybindText = makeMiniWindow("Keybinds", UDim2.new(0, 20, 0.5, -55), 185)
runtime.keybindList = keybindFrame
keybindFrame.Size = UDim2.fromOffset(185, math.max(46, uiTextSize(12) * 4 + 24))
keybindText.Size = UDim2.new(1, 0, 0, math.max(12, uiTextSize(12) + 5))
local keybindRows = new("TextLabel", {
	BackgroundTransparency = 1,
	Position = UDim2.fromOffset(0, math.max(16, uiTextSize(12) + 10)),
	Size = UDim2.new(1, 0, 1, -math.max(16, uiTextSize(12) + 10)),
	Text = "",
	TextColor3 = Color3.fromRGB(180, 180, 180),
	TextSize = 12,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	Parent = keybindFrame,
})

local function keyName(key)
	return state.menuBind or (key and key.Name) or "RightShift"
end

local function inputMatchesMenuBind(input)
	local bind = state.menuBind or "RightShift"
	if input.KeyCode and input.KeyCode.Name == bind then
		return true
	end
	if input.UserInputType and input.UserInputType.Name == bind then
		return true
	end
	return false
end

local function updateKeybindList()
	keybindRows.Text = "( Toggle ) Menu - " .. keyName(state.menuKey)
		.. "\n( Toggle ) Watermark - UI"
		.. "\n( Toggle ) Notifications - UI"
end

local function setOverlayVisible(frame, visible)
	if not frame then
		return
	end
	if visible then
		frame.Visible = true
		frame.BackgroundTransparency = 1
		tween(frame, 0.18, { BackgroundTransparency = 0 })
	else
		local out = tween(frame, 0.15, { BackgroundTransparency = 1 })
		out.Completed:Connect(function()
			if frame.BackgroundTransparency >= 1 then
				frame.Visible = false
			end
		end)
	end
end

local updateAccent

local lastClock = os.clock()
local fps = 60
RunService.RenderStepped:Connect(function()
	local now = os.clock()
	fps = math.floor(1 / math.max(now - lastClock, 1 / 240) + 0.5)
	lastClock = now

	if watermarkFrame.Visible and now - runtime.watermarkTick > 0.35 then
		runtime.watermarkTick = now
		local username = player and player.Name or "player"
		watermarkText.Text = "Anti Hub | " .. username .. " | " .. tostring(fps) .. " fps"
	end
end)

local function applySetting(key, value)
	if state.setters[key] then
		state.setters[key](value, true)
	else
		state.values[key] = value
	end
end

local function applyRuntimeSetting(key, value)
	if key == "watermark" then
		setOverlayVisible(runtime.watermark, value)
	elseif key == "keybinds" then
		updateKeybindList()
		setOverlayVisible(runtime.keybindList, value)
	elseif key == "notifications" then
		if value then
			notify("Notifications enabled", 1.3)
		end
	elseif key == "bind" then
		local map = {
			RightShift = Enum.KeyCode.RightShift,
			Insert = Enum.KeyCode.Insert,
			Home = Enum.KeyCode.Home,
			Delete = Enum.KeyCode.Delete,
		}
		state.menuBind = tostring(value or "RightShift")
		state.menuKey = map[value] or Enum.KeyCode.RightShift
		updateKeybindList()
	elseif key == "theme" then
		local themes = {
			Red = Color3.fromRGB(225, 47, 55),
			Crimson = Color3.fromRGB(185, 35, 52),
			Steel = Color3.fromRGB(116, 164, 204),
			Moss = Color3.fromRGB(117, 174, 129),
			Rose = Color3.fromRGB(196, 111, 128),
		}
		if updateAccent then
			updateAccent(themes[value] or state.accent)
		end
	end
end

local function registerSetter(key, setter)
	state.setters[key] = setter
	if runtime.loadedConfig and runtime.loadedConfig.values and runtime.loadedConfig.values[key] ~= nil then
		setter(runtime.loadedConfig.values[key], true)
	end
end

local function loadConfig(payload)
	payload = payload or loadConfigData() or runtime.loadedConfig
	if not payload then
		notify("No config found", 2, Color3.fromRGB(218, 170, 91))
		return false
	end

	runtime.loadedConfig = payload

	if payload.values then
		for key, value in pairs(payload.values) do
			applySetting(key, value)
		end
	end

	if payload.menuKey and (not payload.values or payload.values.bind == nil) then
		applyRuntimeSetting("bind", payload.menuKey)
	end

	if payload.accent and updateAccent then
		local ok, savedAccent = pcall(function()
			return Color3.fromHex(payload.accent)
		end)
		if ok and savedAccent then
			updateAccent(savedAccent)
		end
	end

	notify("Config loaded", 2, Color3.fromRGB(117, 174, 129))
	return true
end

local function saveConfig()
	local payload = {
		values = state.values,
		accent = state.accent:ToHex(),
		menuKey = state.menuBind or keyName(state.menuKey),
	}

	if hasFileApi() then
		ensureFolder(configFolder)
		local ok = pcall(function()
			writefile(configPath, HttpService:JSONEncode(payload))
		end)
		if ok then
			notify("Config saved", 2, Color3.fromRGB(117, 174, 129))
			return true
		end
	end

	runtime.loadedConfig = payload
	notify("Config saved in memory", 2, Color3.fromRGB(218, 170, 91))
	return false
end


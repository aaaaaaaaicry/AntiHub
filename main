-- main.luau
-- UI Framework principal

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer

-- Configuração global
local CONFIG = {
    folder = "AntiHub_UI",
    windowSize = {690, 580},
    fontScale = 0.42,
}

-- Estado da UI
local UI = {
    accent = Color3.fromRGB(225, 47, 55),
    menuBind = "RightShift",
    menuKey = Enum.KeyCode.RightShift,
    currentTab = "Aimbot",
    visible = true,
    values = {},
    setters = {},
    accentUpdaters = {},
}

-- Tabs disponíveis
local TABS = {
    Aimbot = { icon = "4391741881", subtitle = "aim assist" },
    Visuals = { icon = "1137376343", subtitle = "visual effects" },
    Misc = { icon = "123657916614517", subtitle = "settings & tools" },
}

-- Temas
local THEMES = {
    Red = Color3.fromRGB(225, 47, 55),
    Crimson = Color3.fromRGB(185, 35, 52),
    Steel = Color3.fromRGB(116, 164, 204),
    Moss = Color3.fromRGB(117, 174, 129),
    Rose = Color3.fromRGB(196, 111, 128),
}

-- Cores do tema
local COLORS = {
    bg = Color3.fromRGB(16, 17, 17),
    window = Color3.fromRGB(19, 20, 20),
    topbar = Color3.fromRGB(13, 14, 14),
    panel = Color3.fromRGB(26, 27, 27),
    panel2 = Color3.fromRGB(31, 32, 32),
    panel3 = Color3.fromRGB(22, 23, 23),
    text = Color3.fromRGB(232, 233, 236),
    muted = Color3.fromRGB(154, 156, 164),
    dim = Color3.fromRGB(105, 108, 116),
    accent = UI.accent,
    stroke = Color3.fromRGB(43, 44, 45),
    black = Color3.fromRGB(9, 10, 10),
}

-- Funções utilitárias
local function getParent()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local pg = player:FindFirstChildOfClass("PlayerGui")
    if pg then return pg end
    return game:GetService("CoreGui")
end

local function hasFileAPI()
    return typeof(isfile) == "function"
end

local function tween(obj, time, props)
    local tween = TweenService:Create(obj, TweenInfo.new(time or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

local function new(className, props, children)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    for _, child in ipairs(children or {}) do child.Parent = obj end
    return obj
end

local function corner(radius) return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) }) end
local function stroke(color, trans, thick) return new("UIStroke", { Color = color or COLORS.stroke, Transparency = trans or 0.4, Thickness = thick or 1 }) end
local function padding(l, r, t, b) return new("UIPadding", { PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or l or 0), PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or t or 0) }) end

-- Sistema de notificações
local Notify = {}
function Notify:show(text, duration, color)
    if not self.holder then
        self.holder = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.fromOffset(420, 220), Parent = self.parent or game:GetService("CoreGui") }, {
            new("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 8) })
        })
    end
    
    local card = new("CanvasGroup", { BackgroundColor3 = Color3.fromRGB(12, 12, 12), GroupTransparency = 1, Size = UDim2.fromOffset(0, 28), Parent = self.holder }, {
        stroke(Color3.fromRGB(68, 68, 68), 0.1, 1), padding(8, 8, 0, 0),
        new("Frame", { BackgroundColor3 = color or UI.accent, Size = UDim2.new(1, 16, 0, 2), Position = UDim2.fromOffset(-8, 0) }),
        new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.Arcade, Size = UDim2.new(1, 0, 1, -3), Text = text, TextColor3 = Color3.fromRGB(225, 225, 225), TextSize = 12 })
    })
    
    tween(card, 0.25, { GroupTransparency = 0, Size = UDim2.fromOffset(math.clamp(#text * 9 + 28, 150, 390), 28) })
    task.delay(duration or 2, function()
        if card.Parent then
            local out = tween(card, 0.2, { GroupTransparency = 1, Size = UDim2.fromOffset(0, 28) })
            out.Completed:Connect(function() if card.Parent then card:Destroy() end end)
        end
    end)
end

-- Sistema de configuração
local Config = {}
function Config:save()
    local data = { values = UI.values, accent = UI.accent:ToHex(), menuKey = UI.menuBind }
    if hasFileAPI() then
        pcall(function()
            if not isfolder(CONFIG.folder) then makefolder(CONFIG.folder) end
            writefile(CONFIG.folder .. "/config.json", HttpService:JSONEncode(data))
        end)
        Notify:show("Config saved", 2, Color3.fromRGB(117, 174, 129))
    end
end

function Config:load()
    if not hasFileAPI() then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(CONFIG.folder .. "/config.json"))
        if data and data.values then
            for k, v in pairs(data.values) do UI.values[k] = v end
            if data.accent then UI.accent = Color3.fromHex(data.accent) end
            Notify:show("Config loaded", 2, Color3.fromRGB(117, 174, 129))
        end
    end)
end

-- Componentes da UI
local Components = {}

function Components:Toggle(parent, key, label, default)
    UI.values[key] = default
    local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 25), Parent = parent })
    new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Size = UDim2.new(1, -80, 1, 0), Text = label, TextColor3 = COLORS.text, TextSize = 13, Parent = row })
    
    local btn = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), AutoButtonColor = false, BackgroundColor3 = default and UI.accent or Color3.fromRGB(58, 60, 64), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(38, 20), Parent = row }, { corner(10) })
    local knob = new("Frame", { BackgroundColor3 = Color3.fromRGB(244, 245, 247), Position = default and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(16, 16), Parent = btn }, { corner(8) })
    
    local function update()
        tween(btn, 0.18, { BackgroundColor3 = UI.values[key] and UI.accent or Color3.fromRGB(58, 60, 64) })
        tween(knob, 0.18, { Position = UI.values[key] and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2) })
    end
    
    btn.MouseButton1Click:Connect(function() UI.values[key] = not UI.values[key]; update() end)
    update()
    return btn
end

function Components:Slider(parent, key, label, min, max, default, suffix)
    UI.values[key] = default
    local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 35), Parent = parent })
    new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Size = UDim2.new(1, -76, 0, 17), Text = label, TextColor3 = COLORS.text, TextSize = 13, Parent = row })
    
    local valText = new("TextLabel", { AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = COLORS.panel, Font = Enum.Font.GothamBold, Position = UDim2.new(1, -6, 0, 0), Size = UDim2.fromOffset(38, 25), Parent = row }, { corner(4) })
    local track = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(16, 17, 17), Position = UDim2.fromOffset(4, 24), Size = UDim2.new(1, -74, 0, 3), Parent = row })
    local fill = new("Frame", { BackgroundColor3 = UI.accent, Size = UDim2.fromScale((default - min) / (max - min), 1), Parent = track })
    local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(242, 243, 245), Position = UDim2.fromScale((default - min) / (max - min), 0.5), Size = UDim2.fromOffset(15, 15), Parent = track }, { corner(8) })
    
    local dragging = false
    local function setValue(value)
        value = math.clamp(value, min, max)
        local alpha = (value - min) / (max - min)
        UI.values[key] = value
        valText.Text = suffix and (math.floor(value) .. suffix) or tostring(math.floor(value))
        fill.Size = UDim2.fromScale(alpha, 1)
        knob.Position = UDim2.fromScale(alpha, 0.5)
    end
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local alpha = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
            setValue(min + (max - min) * math.clamp(alpha, 0, 1))
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local alpha = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
            setValue(min + (max - min) * math.clamp(alpha, 0, 1))
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    
    setValue(default)
    return row
end

function Components:Dropdown(parent, key, label, options, default)
    UI.values[key] = default or options[1]
    local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 31), Parent = parent })
    new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Size = UDim2.new(0.52, 0, 1, 0), Text = label, TextColor3 = COLORS.muted, TextSize = 12, Parent = row })
    
    local btn = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), AutoButtonColor = false, BackgroundColor3 = COLORS.panel, Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(142, 30), Parent = row }, { corner(4) })
    local selected = new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -28, 1, 0), Text = UI.values[key], TextColor3 = COLORS.text, TextSize = 12, Parent = btn })
    
    local menu = new("CanvasGroup", { BackgroundColor3 = COLORS.panel, GroupTransparency = 1, Position = UDim2.new(1, -4, 1, 1), Size = UDim2.fromOffset(142, 0), Visible = false, Parent = row }, { corner(4) })
    
    for i, opt in ipairs(options) do
        local optBtn = new("TextButton", { AutoButtonColor = false, BackgroundColor3 = COLORS.panel, Size = UDim2.new(1, 0, 0, 28), Text = "  " .. opt, TextSize = 12, LayoutOrder = i, Parent = menu })
        optBtn.MouseButton1Click:Connect(function()
            UI.values[key] = opt
            selected.Text = opt
            menu.Visible = false
        end)
    end
    
    btn.MouseButton1Click:Connect(function()
        if menu.Visible then
            tween(menu, 0.14, { Size = UDim2.fromOffset(142, 0), GroupTransparency = 1 })
            task.delay(0.15, function() menu.Visible = false end)
        else
            menu.Visible = true
            tween(menu, 0.18, { Size = UDim2.fromOffset(142, math.min(#options, 5) * 28), GroupTransparency = 0 })
        end
    end)
    
    return row
end

-- Criar UI principal
local function createUI()
    local parent = getParent()
    if not parent then return end
    
    local screen = new("ScreenGui", { Name = "Anti_Hub_UI", IgnoreGuiInset = true, Parent = parent })
    local root = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = screen })
    
    Notify.parent = root
    Notify:show("UI Loaded", 1.5, UI.accent)
    
    return root
end

-- Exportar módulo
return {
    UI = UI,
    COLORS = COLORS,
    THEMES = THEMES,
    TABS = TABS,
    Components = Components,
    Notify = Notify,
    Config = Config,
    tween = tween,
    new = new,
    createUI = createUI,
}

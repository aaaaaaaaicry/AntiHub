local function TweenCreate(Item, Info, Goal)
    Info = Info or TweenInfo.new(Library.Tween.Time, Library.Tween.Style, Library.Tween.Direction)
    local tween = TweenService:Create(Item, Info, Goal)
    tween:Play()
    return tween
end

local function InstanceNewWithProps(className, props, children)
    local object = InstanceNew(className)
    for key, value in pairs(props or {}) do object[key] = value end
    for _, child in ipairs(children or {}) do child.Parent = object end
    return object
end

local function MakeDraggable(frame)
    local dragging = false
    local dragStart, startPos
    
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

Library.Holder = InstanceNewWithProps("ScreenGui", { Parent = gethui(), Name = "LibraryUI", ZIndexBehavior = Enum.ZIndexBehavior.Global, IgnoreGuiInset = true })
Library.NotifHolder = InstanceNewWithProps("Frame", { Parent = Library.Holder, BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.34, 0, 1, -14), Name = "Notifications" })
InstanceNewWithProps("UIListLayout", { Parent = Library.NotifHolder, VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10) })

Library.GetImage = function(self, Image) return getcustomasset(self.Folders.Assets .. "/" .. self.Images[Image][1]) end
Library.Round = function(self, Number, Float) local m = 1 / (Float or 1) return MathFloor(Number * m) / m end
Library.IsMouseOverFrame = function(self, Frame) local p = Frame.AbsolutePosition; local s = Frame.AbsoluteSize; return Mouse.X >= p.X and Mouse.X <= p.X + s.X and Mouse.Y >= p.Y and Mouse.Y <= p.Y + s.Y end
Library.Unload = function(self) for _, v in self.Connections do v.Connection:Disconnect() end; for _, v in self.Threads do coroutine.close(v) end; if self.Holder then self.Holder:Destroy() end; getgenv().Library = nil end
Library.Thread = function(self, func) local t = coroutine.create(func); coroutine.wrap(function() coroutine.resume(t) end)(); TableInsert(self.Threads, t); return t end
Library.SafeCall = function(self, func, ...) local args = {...}; local ok, err = pcall(func, table.unpack(args)); if not ok then warn(err) end; return ok end
Library.Connect = function(self, event, callback, name) name = name or string.format("Connection_%s", self.UnnamedConnections + 1); local conn = { Event = event, Callback = callback, Name = name, Connection = event:Connect(callback) }; TableInsert(self.Connections, conn); return conn end
Library.NextFlag = function(self) self.UnnamedFlags = self.UnnamedFlags + 1; return string.format("Flag_%s", self.UnnamedFlags) end
Library.AddToTheme = function(self, item, props) item = item.Instance or item; local data = { Item = item, Properties = props }; for prop, val in props do if type(val) == "string" then item[prop] = self.Theme[val] else item[prop] = val end end; TableInsert(self.ThemeItems, data); self.ThemeMap[item] = data end
Library.GetConfig = function(self) local cfg = {}; for k, v in self.Flags do if type(v) == "table" and v.Key then cfg[k] = {Key = tostring(v.Key), Mode = v.Mode} elseif type(v) == "table" and v.Color then cfg[k] = {Color = v.HexValue, Alpha = v.Alpha} else cfg[k] = v end end; return HttpService:JSONEncode(cfg) end
Library.LoadConfig = function(self, cfg) local decoded = HttpService:JSONDecode(cfg); for k, v in decoded do if self.SetFlags[k] then if type(v) == "table" and v.Key then self.SetFlags[k](v) elseif type(v) == "table" and v.Color then self.SetFlags[k](v.Color, v.Alpha) else self.SetFlags[k](v) end end end; self:Notification("Config loaded", 3, FromRGB(0,255,0)) end
Library.Notification = function(self, text, duration, color) local notif = InstanceNewWithProps("Frame", { Parent = self.NotifHolder, BackgroundColor3 = FromRGB(13,13,13), BorderSizePixel = 2, Size = UDim2.new(0,0,0,24), AutomaticSize = Enum.AutomaticSize.XY }, { InstanceNewWithProps("UIStroke", { Color = FromRGB(68,68,68) }), InstanceNewWithProps("UIPadding", { PaddingTop = UDim.new(0,1), PaddingRight = UDim.new(0,6), PaddingLeft = UDim.new(0,5) }), InstanceNewWithProps("TextLabel", { FontFace = Library.Font, Text = text, TextSize = 12, BackgroundTransparency = 1, Position = UDim2.new(0,0,0,4) }), InstanceNewWithProps("Frame", { BackgroundColor3 = color or self.Theme.Accent, Size = UDim2.new(1,11,0,2), Position = UDim2.new(0,-5,0,-1), BorderSizePixel = 0 }) }); notif.BackgroundTransparency = 1; task.delay(duration or 3, function() notif:Destroy() end); return notif end

Library.Window = function(self, data)
    data = data or {}
    local window = { Name = data.Name or "Window", Size = data.Size or UDim2.new(0,563,0,558), Pages = {}, Sections = {}, IsOpen = true, Items = {} }
    
    local outline = InstanceNewWithProps("Frame", { Parent = self.Holder, AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.new(0.5,0,0.5,0), Size = window.Size, BackgroundColor3 = self.Theme["Window Background"], BorderSizePixel = 2 })
    self:AddToTheme(outline, { BackgroundColor3 = "Window Background", BorderColor3 = "Outline" })
    InstanceNewWithProps("UIStroke", { Parent = outline, Color = self.Theme.Border }, { self:AddToTheme(_, { Color = "Border" }) })
    MakeDraggable(outline)
    
    local inline = InstanceNewWithProps("Frame", { Parent = outline, Position = UDim2.new(0,5,0,5), Size = UDim2.new(1,-10,1,-10), BackgroundColor3 = self.Theme.Inline, BorderSizePixel = 2 }, { InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BackgroundColor3 = "Inline", BorderColor3 = "Border" }) })
    
    local liner = InstanceNewWithProps("Frame", { Parent = inline, Size = UDim2.new(1,0,0,2), BackgroundColor3 = self.Theme.Accent, BorderSizePixel = 0 }, { InstanceNewWithProps("UIGradient", { Rotation = 90, Color = RGBSequence{ RGBSequenceKeypoint(0, FromRGB(255,255,255)), RGBSequenceKeypoint(1, FromRGB(125,125,125)) } }), self:AddToTheme(_, { BackgroundColor3 = "Accent" }) })
    
    local titleFrame = InstanceNewWithProps("Frame", { Parent = inline, Position = UDim2.new(0,13,0,20), Size = UDim2.new(0.188,0,0,37), BackgroundColor3 = self.Theme.Inline, BorderSizePixel = 2 }, { InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BackgroundColor3 = "Inline", BorderColor3 = "Border" }) })
    local title = InstanceNewWithProps("TextLabel", { Parent = titleFrame, FontFace = Library.Font, Text = window.Name, TextSize = 12, BackgroundTransparency = 1, Size = UDim2.new(1,0,1,-1), Position = UDim2.new(0,0,0,-1) }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    
    local pagesFrame = InstanceNewWithProps("Frame", { Parent = inline, Position = UDim2.new(0.188,28,0,20), Size = UDim2.new(0.736,0,0,37), BackgroundColor3 = self.Theme.Inline, BorderSizePixel = 2 }, { InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BackgroundColor3 = "Inline", BorderColor3 = "Border" }) })
    local pagesHolder = InstanceNewWithProps("Frame", { Parent = pagesFrame, BackgroundTransparency = 1, Position = UDim2.new(0,20,0,0), Size = UDim2.new(1,-40,1,0) })
    InstanceNewWithProps("UIListLayout", { Parent = pagesHolder, FillDirection = Enum.FillDirection.Horizontal, HorizontalFlex = Enum.UIFlexAlignment.Fill, Padding = UDim.new(0,15) })
    
    local content = InstanceNewWithProps("Frame", { Parent = inline, Position = UDim2.new(0,13,0,77), Size = UDim2.new(1,-28,1,-93), BackgroundColor3 = self.Theme.Inline, BorderSizePixel = 2 }, { InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BackgroundColor3 = "Inline", BorderColor3 = "Border" }) })
    
    window.Items = { Outline = outline, Inline = inline, PagesHolder = pagesHolder, Content = content }
    
    self:Connect(UserInputService.InputBegan, function(input) if tostring(input.KeyCode) == self.MenuKeybind or tostring(input.UserInputType) == self.MenuKeybind then outline.Visible = not outline.Visible end end)
    
    return window
end

Library.Page = function(self, data)
    data = data or {}
    local page = { Window = self, Name = data.Name or "Page", Columns = data.Columns or 2, ColumnsData = {}, Active = false, Items = {} }
    
    local pageFrame = InstanceNewWithProps("Frame", { Parent = page.Window.Items.Content, BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0), Visible = false })
    InstanceNewWithProps("UIListLayout", { Parent = pageFrame, FillDirection = Enum.FillDirection.Horizontal, HorizontalFlex = Enum.UIFlexAlignment.Fill, Padding = UDim.new(0,20) })
    
    for i = 1, page.Columns do
        local column = InstanceNewWithProps("ScrollingFrame", { Parent = pageFrame, BackgroundTransparency = 1, Size = UDim2.new(0,100,0,100), ScrollBarThickness = 0, AutomaticCanvasSize = Enum.AutomaticSize.Y }, 
            { InstanceNewWithProps("UIListLayout", { Padding = UDim.new(0,17) }), InstanceNewWithProps("UIPadding", { PaddingTop = UDim.new(0,18), PaddingBottom = UDim.new(0,15), PaddingLeft = UDim.new(0, i == 1 and 18 or 5), PaddingRight = UDim.new(0, i == 1 and 5 or 18) }) })
        page.ColumnsData[i] = column
    end
    
    local pageButton = InstanceNewWithProps("TextButton", { Parent = page.Window.Items.PagesHolder, Text = page.Name, TextSize = 12, AutoButtonColor = false, BackgroundTransparency = 1 }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    local liner = InstanceNewWithProps("Frame", { Parent = pageButton, AnchorPoint = Vector2.new(0.5,1), Position = UDim2.new(0.5,0,1,0), Size = UDim2.new(1,0,0,2), BackgroundColor3 = self.Theme["Dark Liner"] }, { self:AddToTheme(_, { BackgroundColor3 = "Dark Liner" }) })
    local glow = InstanceNewWithProps("Frame", { Parent = pageButton, AnchorPoint = Vector2.new(0.5,1), Position = UDim2.new(0.5,0,1,0), Size = UDim2.new(1,2,0,0), BackgroundTransparency = 1, BackgroundColor3 = self.Theme.Accent }, { self:AddToTheme(_, { BackgroundColor3 = "Accent" }) })
    
    local pagesTable = page.Window.Pages
    table.insert(pagesTable, { Turn = function(b) pageFrame.Visible = b; pageButton.TextColor3 = b and self.Theme.Accent or self.Theme.Text; liner.BackgroundColor3 = b and self.Theme.Accent or self.Theme["Dark Liner"]; glow.BackgroundTransparency = b and 0 or 1; glow.Size = b and UDim2.new(1,2,1,0) or UDim2.new(1,2,0,0) end })
    if #pagesTable == 1 then pagesTable[1]:Turn(true) end
    
    pageButton.MouseButton1Click:Connect(function() for _, v in pagesTable do v:Turn(v == pagesTable[#pagesTable]) page.Active = (v == pagesTable[#pagesTable]) end end)
    
    page.Items = { PageFrame = pageFrame, PageButton = pageButton }
    return page
end

Library.Section = function(self, data)
    data = data or {}
    local section = { Window = self.Window, Page = self.Page, Name = data.Name or "Section", Side = data.Side or 1, Items = {} }
    
    local frame = InstanceNewWithProps("Frame", { Parent = section.Page.ColumnsData[section.Side], Size = UDim2.new(1,0,0,25), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = self.Theme["Section Background"], BorderSizePixel = 2 }, 
        { InstanceNewWithProps("UIStroke", {}), InstanceNewWithProps("UIPadding", { PaddingBottom = UDim.new(0,10) }), self:AddToTheme(_, { BackgroundColor3 = "Section Background", BorderColor3 = "Border" }) })
    
    local titleBar = InstanceNewWithProps("Frame", { Parent = frame, Position = UDim2.new(0,2,0,-2), Size = UDim2.new(1,-4,0,2), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = self.Theme.Accent }, 
        { InstanceNewWithProps("UIGradient", { Color = RGBSequence{ RGBSequenceKeypoint(0, FromRGB(226,226,226)), RGBSequenceKeypoint(1, FromRGB(255,255,255)) }, Transparency = NumSequence{ NumSequenceKeypoint(0,0.5125), NumSequenceKeypoint(0.42,0.76875), NumSequenceKeypoint(1,1) } }), self:AddToTheme(_, { BackgroundColor3 = "Accent" }) })
    
    local title = InstanceNewWithProps("TextLabel", { Parent = titleBar, Text = string.upper(section.Name), TextSize = 12, BackgroundColor3 = self.Theme["Section Background"], Position = UDim2.new(0,9,0,0), Size = UDim2.new(0,40,0,13), AutomaticSize = Enum.AutomaticSize.X }, 
        { InstanceNewWithProps("UIPadding", { PaddingLeft = UDim.new(0,3), PaddingRight = UDim.new(0,4) }), self:AddToTheme(_, { TextColor3 = "Text", BackgroundColor3 = "Section Background" }) })
    
    local content = InstanceNewWithProps("Frame", { Parent = frame, BackgroundTransparency = 1, Position = UDim2.new(0,12,0,17), Size = UDim2.new(1,-24,1,-20) }, 
        { InstanceNewWithProps("UIListLayout", { Padding = UDim.new(0,6) }) })
    
    section.Items = { Frame = frame, Content = content }
    return section
end

-- ==================== COLORPICKER COMPLETO ====================

Library.Colorpicker = function(self, parent, name, defaultColor, alpha, callback)
    local colorData = { Color = defaultColor or FromRGB(255,255,255), Alpha = alpha or 1, Hue = 0, Sat = 1, Val = 1, IsOpen = false }
    colorData.Hue, colorData.Sat, colorData.Val = colorData.Color:ToHSV()
    
    local frame = InstanceNewWithProps("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1,0,0,55) })
    
    local label = InstanceNewWithProps("TextLabel", { Parent = frame, Text = name, TextSize = 12, BackgroundTransparency = 1, Position = UDim2.new(0,4,0,0), Size = UDim2.new(1,-96,0,20), TextXAlignment = Enum.TextXAlignment.Left }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    
    local hexText = InstanceNewWithProps("TextLabel", { Parent = frame, AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-41,0,0), Size = UDim2.new(0,61,0,22), Text = "#" .. colorData.Color:ToHex(), TextSize = 11, BackgroundColor3 = self.Theme.Element }, { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(0,4) }), self:AddToTheme(_, { TextColor3 = "Text", BackgroundColor3 = "Element" }) })
    
    local swatch = InstanceNewWithProps("TextButton", { Parent = frame, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-7,0.5,0), Size = UDim2.new(0,25,0,25), BackgroundColor3 = colorData.Color, Text = "", AutoButtonColor = false }, 
        { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(0,4) }), InstanceNewWithProps("UIStroke", { Color = FromRGB(220,222,227), Transparency = 0.65 }) })
    
    local pickerPanel = InstanceNewWithProps("Frame", { Parent = frame, Position = UDim2.new(0,0,0,58), Size = UDim2.new(1,0,0,190), Visible = false, BackgroundColor3 = self.Theme["Section Background"], ZIndex = 100 }, 
        { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(0,4) }), InstanceNewWithProps("UIStroke", {}), InstanceNewWithProps("UIPadding", { PaddingLeft = UDim.new(0,8), PaddingRight = UDim.new(0,8), PaddingTop = UDim.new(0,8), PaddingBottom = UDim.new(0,8) }), self:AddToTheme(_, { BackgroundColor3 = "Section Background", BorderColor3 = "Border" }) })
    
    -- Palette (Saturation/Value)
    local palette = InstanceNewWithProps("TextButton", { Parent = pickerPanel, Position = UDim2.new(0,0,0,0), Size = UDim2.new(1,0,0,120), BackgroundColor3 = FromHSV(colorData.Hue, 1, 1), Text = "", AutoButtonColor = false }, 
        { InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BorderColor3 = "Border" }) })
    
    local satImage = InstanceNewWithProps("ImageLabel", { Parent = palette, Image = self:GetImage("Saturation"), Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1 })
    local valImage = InstanceNewWithProps("ImageLabel", { Parent = palette, Image = self:GetImage("Value"), Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1 })
    local paletteDrag = InstanceNewWithProps("Frame", { Parent = palette, Size = UDim2.new(0,3,0,3), Position = UDim2.new(1 - colorData.Sat, 0, 1 - colorData.Val, 0), BackgroundColor3 = FromRGB(255,255,255), ZIndex = 101 }, 
        { InstanceNewWithProps("UIStroke", {}), InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(1,0) }) })
    
    -- Hue slider
    local hueSlider = InstanceNewWithProps("ImageButton", { Parent = pickerPanel, Position = UDim2.new(0,0,0,128), Size = UDim2.new(1,0,0,15), Image = self:GetImage("Hue"), AutoButtonColor = false }, 
        { InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BorderColor3 = "Border" }) })
    local hueDrag = InstanceNewWithProps("Frame", { Parent = hueSlider, Size = UDim2.new(0,2,1,0), Position = UDim2.new(colorData.Hue, 0, 0, 0), BackgroundColor3 = FromRGB(255,255,255), ZIndex = 101 }, 
        { InstanceNewWithProps("UIStroke", {}) })
    
    -- Alpha slider
    local alphaSlider = InstanceNewWithProps("TextButton", { Parent = pickerPanel, Position = UDim2.new(0,0,0,151), Size = UDim2.new(1,0,0,15), Text = "", AutoButtonColor = false, BackgroundColor3 = colorData.Color }, 
        { InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BorderColor3 = "Border" }) })
    local checkers = InstanceNewWithProps("ImageLabel", { Parent = alphaSlider, Image = self:GetImage("Checkers"), ScaleType = Enum.ScaleType.Tile, TileSize = UDim2.new(0,8,0,8), Size = UDim2.new(1,0,1,0) })
    local alphaDrag = InstanceNewWithProps("Frame", { Parent = alphaSlider, Size = UDim2.new(0,2,1,0), Position = UDim2.new(colorData.Alpha, 0, 0, 0), BackgroundColor3 = FromRGB(255,255,255), ZIndex = 101 }, 
        { InstanceNewWithProps("UIStroke", {}) })
    
    -- Color info
    local infoFrame = InstanceNewWithProps("Frame", { Parent = pickerPanel, Position = UDim2.new(0,0,0,174), Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, 
        { InstanceNewWithProps("UIListLayout", { Padding = UDim.new(0,4), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })
    
    local rgbText = InstanceNewWithProps("TextLabel", { Parent = infoFrame, Text = "RGB: 255, 255, 255", TextSize = 11, BackgroundTransparency = 1, Size = UDim2.new(1,0,0,14) }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    local hsvText = InstanceNewWithProps("TextLabel", { Parent = infoFrame, Text = "HSV: 0.00, 1.00, 1.00", TextSize = 11, BackgroundTransparency = 1, Size = UDim2.new(1,0,0,14) }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    
    local dragging = { palette = false, hue = false, alpha = false }
    
    local function updateColor()
        local newColor = FromHSV(colorData.Hue, colorData.Sat, colorData.Val)
        colorData.Color = newColor
        swatch.BackgroundColor3 = newColor
        hexText.Text = "#" .. newColor:ToHex()
        rgbText.Text = string.format("RGB: %d, %d, %d", MathFloor(newColor.R * 255), MathFloor(newColor.G * 255), MathFloor(newColor.B * 255))
        hsvText.Text = string.format("HSV: %.2f, %.2f, %.2f", colorData.Hue, colorData.Sat, colorData.Val)
        palette.BackgroundColor3 = FromHSV(colorData.Hue, 1, 1)
        alphaSlider.BackgroundColor3 = newColor
        if callback then callback(newColor, colorData.Alpha) end
    end
    
    local function setFromPalette(x, y)
        colorData.Sat = MathClamp(1 - (x - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
        colorData.Val = MathClamp(1 - (y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
        paletteDrag.Position = UDim2.new(1 - colorData.Sat, 0, 1 - colorData.Val, 0)
        updateColor()
    end
    
    local function setFromHue(x)
        colorData.Hue = MathClamp((x - hueSlider.AbsolutePosition.X) / hueSlider.AbsoluteSize.X, 0, 1)
        hueDrag.Position = UDim2.new(colorData.Hue, 0, 0, 0)
        updateColor()
    end
    
    local function setFromAlpha(x)
        colorData.Alpha = MathClamp((x - alphaSlider.AbsolutePosition.X) / alphaSlider.AbsoluteSize.X, 0, 1)
        alphaDrag.Position = UDim2.new(colorData.Alpha, 0, 0, 0)
        if callback then callback(colorData.Color, colorData.Alpha) end
    end
    
    palette.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging.palette = true
            setFromPalette(input.Position.X, input.Position.Y)
        end
    end)
    palette.InputEnded:Connect(function() dragging.palette = false end)
    
    hueSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging.hue = true
            setFromHue(input.Position.X)
        end
    end)
    hueSlider.InputEnded:Connect(function() dragging.hue = false end)
    
    alphaSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging.alpha = true
            setFromAlpha(input.Position.X)
        end
    end)
    alphaSlider.InputEnded:Connect(function() dragging.alpha = false end)
    
    self:Connect(UserInputService.InputChanged, function(input)
        if dragging.palette and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromPalette(input.Position.X, input.Position.Y)
        elseif dragging.hue and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromHue(input.Position.X)
        elseif dragging.alpha and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromAlpha(input.Position.X)
        end
    end)
    
    swatch.MouseButton1Click:Connect(function()
        pickerPanel.Visible = not pickerPanel.Visible
    end)
    
    self:Connect(UserInputService.InputBegan, function(input)
        if pickerPanel.Visible and input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not self:IsMouseOverFrame(pickerPanel) and not self:IsMouseOverFrame(swatch) then
                pickerPanel.Visible = false
            end
        end
    end)
    
    return {
        Set = function(_, color, a) colorData.Hue, colorData.Sat, colorData.Val = color:ToHSV(); colorData.Alpha = a or 1; updateColor() end,
        Get = function() return colorData.Color, colorData.Alpha end,
        SetVisibility = function(_, vis) frame.Visible = vis end
    }
end

-- ==================== COMPONENTES SIMPLES ====================

Library.Toggle = function(self, parent, name, default, risky, tooltip, callback)
    local value = default or false
    local frame = InstanceNewWithProps("TextButton", { Parent = parent, Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1,0,0,15) })
    if tooltip then frame.Tooltip = tooltip end
    
    local indicator = InstanceNewWithProps("Frame", { Parent = frame, AnchorPoint = Vector2.new(0,0.5), Position = UDim2.new(0,0,0.5,0), Size = UDim2.new(0,10,0,10), BackgroundColor3 = value and self.Theme.Accent or self.Theme.Element }, 
        { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(1,0) }), InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BackgroundColor3 = "Element", BorderColor3 = "Border" }) })
    
    local label = InstanceNewWithProps("TextLabel", { Parent = frame, Text = name, TextSize = 12, BackgroundTransparency = 1, Position = UDim2.new(0,18,0,-1), Size = UDim2.new(1,-18,1,0), TextXAlignment = Enum.TextXAlignment.Left }, 
        { self:AddToTheme(_, { TextColor3 = risky and "Risky" or "Text" }) })
    
    local function set(v)
        value = v
        indicator.BackgroundColor3 = value and self.Theme.Accent or self.Theme.Element
        if not risky then label.TextColor3 = value and self.Theme.Accent or self.Theme.Text end
        if callback then callback(value) end
    end
    
    frame.MouseButton1Click:Connect(function() set(not value) end)
    set(value)
    
    return { Set = set, Get = function() return value end }
end

Library.Button = function(self, parent, name, risky, tooltip, callback)
    local frame = InstanceNewWithProps("TextButton", { Parent = parent, Text = "", AutoButtonColor = false, Size = UDim2.new(1,0,0,17), BackgroundColor3 = self.Theme.Element }, 
        { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(0,3) }), InstanceNewWithProps("UIStroke", {}), InstanceNewWithProps("UIGradient", { Rotation = 90, Color = RGBSequence{ RGBSequenceKeypoint(0, FromRGB(255,255,255)), RGBSequenceKeypoint(1, FromRGB(127,127,127)) } }), self:AddToTheme(_, { BackgroundColor3 = "Element", BorderColor3 = "Border" }) })
    if tooltip then frame.Tooltip = tooltip end
    
    local label = InstanceNewWithProps("TextLabel", { Parent = frame, Text = name, TextSize = 12, BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0), Position = UDim2.new(0,0,0,-1) }, 
        { self:AddToTheme(_, { TextColor3 = risky and "Risky" or "Text" }) })
    
    frame.MouseButton1Click:Connect(function() if callback then callback() end end)
    return { Press = function() if callback then callback() end end }
end

Library.Slider = function(self, parent, name, min, max, default, suffix, tooltip, callback)
    local value = default or min
    local frame = InstanceNewWithProps("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1,0,0,35) })
    if tooltip then frame.Tooltip = tooltip end
    
    local label = InstanceNewWithProps("TextLabel", { Parent = frame, Text = name, TextSize = 12, BackgroundTransparency = 1, Position = UDim2.new(0,4,0,0), Size = UDim2.new(1,-76,0,17), TextXAlignment = Enum.TextXAlignment.Left }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    
    local valueBox = InstanceNewWithProps("TextLabel", { Parent = frame, AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-6,0,0), Size = UDim2.new(0,38,0,25), Text = tostring(value) .. (suffix or ""), TextSize = 11, BackgroundColor3 = self.Theme.Element }, 
        { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(0,4) }), self:AddToTheme(_, { TextColor3 = "Text", BackgroundColor3 = "Element" }) })
    
    local track = InstanceNewWithProps("TextButton", { Parent = frame, Position = UDim2.new(0,4,0,24), Size = UDim2.new(1,-74,0,3), Text = "", AutoButtonColor = false, BackgroundColor3 = FromRGB(40,40,40) })
    local fill = InstanceNewWithProps("Frame", { Parent = track, Size = UDim2.new((value - min) / (max - min), 0, 1, 0), BackgroundColor3 = self.Theme.Accent }, { self:AddToTheme(_, { BackgroundColor3 = "Accent" }) })
    local knob = InstanceNewWithProps("Frame", { Parent = track, AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0), Size = UDim2.new(0,10,0,10), BackgroundColor3 = FromRGB(255,255,255) }, { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(1,0) }) })
    
    local dragging = false
    local function setFromMouse(x)
        local alpha = MathClamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local newVal = min + (max - min) * alpha
        value = newVal
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueBox.Text = tostring(MathFloor(value)) .. (suffix or "")
        if callback then callback(value) end
    end
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            setFromMouse(input.Position.X)
        end
    end)
    track.InputEnded:Connect(function() dragging = false end)
    
    self:Connect(UserInputService.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromMouse(input.Position.X)
        end
    end)
    
    return { Set = function(_, v) setFromMouse(track.AbsolutePosition.X + ((v - min) / (max - min)) * track.AbsoluteSize.X) end, Get = function() return value end }
end

Library.Dropdown = function(self, parent, name, items, default, tooltip, callback)
    local selected = default or items[1]
    local frame = InstanceNewWithProps("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1,0,0,31) })
    if tooltip then frame.Tooltip = tooltip end
    
    local label = InstanceNewWithProps("TextLabel", { Parent = frame, Text = name, TextSize = 12, BackgroundTransparency = 1, Position = UDim2.new(0,4,0,0), Size = UDim2.new(0.5,0,1,0), TextXAlignment = Enum.TextXAlignment.Left }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    
    local button = InstanceNewWithProps("TextButton", { Parent = frame, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-4,0.5,0), Size = UDim2.new(0,142,0,25), Text = "", AutoButtonColor = false, BackgroundColor3 = self.Theme.Element }, 
        { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(0,4) }), self:AddToTheme(_, { BackgroundColor3 = "Element" }) })
    
    local valueLabel = InstanceNewWithProps("TextLabel", { Parent = button, Text = selected, TextSize = 11, BackgroundTransparency = 1, Position = UDim2.new(0,8,0,0), Size = UDim2.new(1,-20,1,0), TextXAlignment = Enum.TextXAlignment.Left }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    
    local arrow = InstanceNewWithProps("TextLabel", { Parent = button, Text = "v", TextSize = 11, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-8,0,0), Size = UDim2.new(0,13,1,0) }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    
    local open = false
    local dropdownFrame = InstanceNewWithProps("Frame", { Parent = frame, Position = UDim2.new(1,0,1,2), Size = UDim2.new(0,142,0,0), BackgroundColor3 = self.Theme["Section Background"], Visible = false, ZIndex = 200, AnchorPoint = Vector2.new(1,0) }, 
        { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(0,4) }), InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BackgroundColor3 = "Section Background", BorderColor3 = "Border" }) })
    
    local list = InstanceNewWithProps("UIListLayout", { Parent = dropdownFrame, Padding = UDim.new(0,2) })
    
    local optionButtons = {}
    for _, item in pairs(items) do
        local opt = InstanceNewWithProps("TextButton", { Parent = dropdownFrame, Text = "  " .. item, TextSize = 11, AutoButtonColor = false, Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left }, 
            { InstanceNewWithProps("UIPadding", { PaddingLeft = UDim.new(0,8) }), self:AddToTheme(_, { TextColor3 = "Text" }) })
        opt.MouseButton1Click:Connect(function()
            selected = item
            valueLabel.Text = item
            if callback then callback(item) end
            for _, b in pairs(optionButtons) do b.TextColor3 = self.Theme.Text end
            opt.TextColor3 = self.Theme.Accent
            dropdownFrame.Visible = false
            open = false
            arrow.Text = "v"
        end)
        optionButtons[item] = opt
        if item == selected then opt.TextColor3 = self.Theme.Accent end
    end
    
    button.MouseButton1Click:Connect(function()
        open = not open
        dropdownFrame.Visible = open
        arrow.Text = open and "^" or "v"
        if open then
            dropdownFrame.Size = UDim2.new(0,142,0,math.min(#items * 24, 120))
        end
    end)
    
    self:Connect(UserInputService.InputBegan, function(input)
        if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not self:IsMouseOverFrame(dropdownFrame) and not self:IsMouseOverFrame(button) then
                dropdownFrame.Visible = false
                open = false
                arrow.Text = "v"
            end
        end
    end)
    
    return { Set = function(_, v) for _, b in pairs(optionButtons) do b.TextColor3 = self.Theme.Text end; if optionButtons[v] then optionButtons[v].TextColor3 = self.Theme.Accent; selected = v; valueLabel.Text = v; if callback then callback(v) end end end, Get = function() return selected end }
end

Library.Textbox = function(self, parent, name, default, placeholder, tooltip, callback)
    local value = default or ""
    local frame = InstanceNewWithProps("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1,0,0,37) })
    if tooltip then frame.Tooltip = tooltip end
    
    local label = InstanceNewWithProps("TextLabel", { Parent = frame, Text = name, TextSize = 12, BackgroundTransparency = 1, Position = UDim2.new(0,4,0,0), Size = UDim2.new(1,0,0,13), TextXAlignment = Enum.TextXAlignment.Left }, { self:AddToTheme(_, { TextColor3 = "Text" }) })
    
    local bg = InstanceNewWithProps("Frame", { Parent = frame, AnchorPoint = Vector2.new(0,1), Position = UDim2.new(0,0,1,0), Size = UDim2.new(1,0,0,17), BackgroundColor3 = self.Theme.Element }, 
        { InstanceNewWithProps("UICorner", { CornerRadius = UDim.new(0,4) }), InstanceNewWithProps("UIStroke", {}), self:AddToTheme(_, { BackgroundColor3 = "Element", BorderColor3 = "Border" }) })
    
    local textbox = InstanceNewWithProps("TextBox", { Parent = bg, Text = value, PlaceholderText = placeholder or "...", TextSize = 11, BackgroundTransparency = 1, Position = UDim2.new(0,0,0,0), Size = UDim2.new(1,0,1,0), ClearTextOnFocus = false }, 
        { InstanceNewWithProps("UIPadding", { PaddingLeft = UDim.new(0,5) }), self:AddToTheme(_, { TextColor3 = "Text", PlaceholderColor3 = "Text" }) })
    
    textbox.FocusLost:Connect(function() value = textbox.Text; if callback then callback(value) end end)
    
    return { Set = function(_, v) value = v; textbox.Text = v; if callback then callback(v) end end, Get = function() return value end }
end

-- Exportar
getgenv().Library = Library
return Library

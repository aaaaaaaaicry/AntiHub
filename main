local bottom = new("Frame", {
	Name = "BottomBar",
	AnchorPoint = Vector2.new(0.5, 1),
	BackgroundColor3 = Color3.fromRGB(21, 22, 22),
	BorderSizePixel = 0,
	Position = UDim2.new(0.5, 0, 1, -9),
	Size = UDim2.fromOffset(622, 64),

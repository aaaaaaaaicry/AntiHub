            local itemHandling = {}

            function itemHandling:Button(btnText, callback)
                local TextButton = Instance.new("TextButton")
                local UICorner = Instance.new("UICorner")

                TextButton.Parent = sectionFrame
                TextButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                TextButton.Size = UDim2.new(1, -10, 0, 32)
                TextButton.AutoButtonColor = false
                TextButton.Font = Enum.Font.GothamSemibold
                TextButton.Text = btnText
                TextButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                TextButton.TextSize = 13

                UICorner.CornerRadius = UDim.new(0, 5)
                UICorner.Parent = TextButton

                local clickDebounce = false
                local callbackDebounce = false

                TextButton.MouseButton1Click:Connect(function()
                    if not callbackDebounce then
                        callbackDebounce = true
                        callback()
                        wait(0.3)
                        callbackDebounce = false
                    end
                end)
                
                TextButton.MouseButton1Down:Connect(function()
                    if not clickDebounce then
                        clickDebounce = true
                        TextButton:TweenSize(UDim2.new(1, -15, 0, 29), "Out", "Quad", 0.05)
                        wait(0.2)
                        clickDebounce = false
                    end
                end)
                
                TextButton.MouseButton1Up:Connect(function()
                    TextButton:TweenSize(UDim2.new(1, -10, 0, 32), "Out", "Quad", 0.05)
                end)
                
                TextButton.MouseEnter:Connect(function()
                    TextButton:TweenSize(UDim2.new(1, -8, 0, 32), "Out", "Quad", 0.05)
                    TextButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                end)
                
                TextButton.MouseLeave:Connect(function()
                    TextButton:TweenSize(UDim2.new(1, -10, 0, 32), "Out", "Quad", 0.05)
                    TextButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                end)
            end
            
            function itemHandling:Toggle(togInfo, callback)
                local tog = false
                local toggleFrame = Instance.new("Frame")
                local checkBox = Instance.new("ImageButton")
                local UIListLayout = Instance.new("UIListLayout")
                local checkBoxInfo = Instance.new("TextLabel")

                toggleFrame.Name = "toggleFrame"
                toggleFrame.Parent = sectionFrame
                toggleFrame.BackgroundTransparency = 1
                toggleFrame.Size = UDim2.new(1, -10, 0, 28)

                checkBox.Name = "checkBox"
                checkBox.Parent = toggleFrame
                checkBox.BackgroundTransparency = 1
                checkBox.Size = UDim2.new(0, 22, 0, 22)
                checkBox.Image = "rbxassetid://3926311105"
                checkBox.ImageColor3 = Color3.fromRGB(80, 80, 100)
                checkBox.ImageRectOffset = Vector2.new(940, 784)
                checkBox.ImageRectSize = Vector2.new(48, 48)

                UIListLayout.Parent = toggleFrame
                UIListLayout.FillDirection = Enum.FillDirection.Horizontal
                UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Center
                UIListLayout.Padding = UDim.new(0, 8)

                checkBoxInfo.Name = "checkBoxInfo"
                checkBoxInfo.Parent = toggleFrame
                checkBoxInfo.BackgroundTransparency = 1
                checkBoxInfo.Size = UDim2.new(1, -30, 0, 25)
                checkBoxInfo.Font = Enum.Font.Gotham
                checkBoxInfo.Text = togInfo
                checkBoxInfo.TextColor3 = Color3.fromRGB(180, 180, 200)
                checkBoxInfo.TextSize = 12
                checkBoxInfo.TextXAlignment = Enum.TextXAlignment.Left
                
                local clickDe = false

                checkBox.MouseButton1Click:Connect(function()
                    if not clickDe then
                        clickDe = true
                        tog = not tog
                        callback(tog)
                        if tog then
                            checkBoxInfo.TextColor3 = Color3.fromRGB(200, 50, 50)
                            checkBox.ImageRectOffset = Vector2.new(4, 836)
                            checkBox.ImageColor3 = Color3.fromRGB(200, 50, 50)
                        else
                            checkBoxInfo.TextColor3 = Color3.fromRGB(180, 180, 200)
                            checkBox.ImageRectOffset = Vector2.new(940, 784)
                            checkBox.ImageColor3 = Color3.fromRGB(80, 80, 100)
                        end
                        wait(0.3)
                        clickDe = false
                    end
                end)
            end
            
            function itemHandling:TextBox(textInfo, callback)
                local TextBox = Instance.new("TextBox")
                local UICorner = Instance.new("UICorner")

                TextBox.Parent = sectionFrame
                TextBox.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                TextBox.Size = UDim2.new(1, -10, 0, 30)
                TextBox.ClearTextOnFocus = false
                TextBox.Font = Enum.Font.Gotham
                TextBox.PlaceholderText = textInfo
                TextBox.Text = ""
                TextBox.TextColor3 = Color3.fromRGB(200, 50, 50)
                TextBox.TextSize = 12

                UICorner.CornerRadius = UDim.new(0, 5)
                UICorner.Parent = TextBox

                TextBox.FocusLost:Connect(function(EnterPressed)
                    if EnterPressed then
                        callback(TextBox.Text)
                        TextBox.Text = ""  
                    end
                end)
            end

            function itemHandling:Slider(sliderInf, maxvalue, minvalue, callback)
                local sliderFrame = Instance.new("Frame")
                local sliderInfo = Instance.new("TextLabel")
                local sliderBtn = Instance.new("TextButton")
                local SliderDrag = Instance.new("Frame")
                local UICorner = Instance.new("UICorner")
                local UICorner_1 = Instance.new("UICorner")
                local sliderBox = Instance.new("TextBox")
                
                sliderInf = sliderInf or "Slider"
                minvalue = minvalue or 0
                maxvalue = maxvalue or 100

                sliderFrame.Name = "sliderFrame"
                sliderFrame.Parent = sectionFrame
                sliderFrame.BackgroundTransparency = 1
                sliderFrame.Size = UDim2.new(1, -10, 0, 45)

                sliderInfo.Parent = sliderFrame
                sliderInfo.BackgroundTransparency = 1
                sliderInfo.Size = UDim2.new(1, 0, 0, 18)
                sliderInfo.Font = Enum.Font.Gotham
                sliderInfo.Text = sliderInf
                sliderInfo.TextColor3 = Color3.fromRGB(180, 180, 200)
                sliderInfo.TextSize = 12
                sliderInfo.TextXAlignment = Enum.TextXAlignment.Left

                sliderBtn.Parent = sliderFrame
                sliderBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                sliderBtn.BorderSizePixel = 0
                sliderBtn.Position = UDim2.new(0, 0, 0.45, 0)
                sliderBtn.Size = UDim2.new(0, 280, 0, 6)
                sliderBtn.AutoButtonColor = false
                sliderBtn.Text = ""

                SliderDrag.Parent = sliderBtn
                SliderDrag.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                SliderDrag.BorderColor3 = Color3.fromRGB(200, 50, 50)
                SliderDrag.Size = UDim2.new(0, 0, 0, 6)

                UICorner.CornerRadius = UDim.new(0, 99)
                UICorner.Parent = SliderDrag

                UICorner_1.CornerRadius = UDim.new(0, 99)
                UICorner_1.Parent = sliderBtn

                sliderBox.Parent = sliderFrame
                sliderBox.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                sliderBox.Position = UDim2.new(0.78, 0, 0.45, 0)
                sliderBox.Size = UDim2.new(0, 45, 0, 22)
                sliderBox.ClearTextOnFocus = false
                sliderBox.Font = Enum.Font.Gotham
                sliderBox.Text = tostring(minvalue)
                sliderBox.TextColor3 = Color3.fromRGB(200, 50, 50)
                sliderBox.TextSize = 11
                sliderBox.TextXAlignment = Enum.TextXAlignment.Center
                
                local boxCorner = Instance.new("UICorner")
                boxCorner.CornerRadius = UDim.new(0, 4)
                boxCorner.Parent = sliderBox
                
                local mouse = game.Players.LocalPlayer:GetMouse()
                local uis = game:GetService("UserInputService")
                local Value = minvalue
                
                local function updateSlider(value)
                    local percent = (value - minvalue) / (maxvalue - minvalue)
                    local width = math.clamp(percent * 280, 0, 280)
                    SliderDrag:TweenSize(UDim2.new(0, width, 0, 6), "Out", "Quad", 0.1)
                end
                
                sliderBtn.MouseButton1Down:Connect(function()
                    local mouseX = math.clamp(mouse.X - sliderBtn.AbsolutePosition.X, 0, 280)
                    Value = math.floor(minvalue + (mouseX / 280) * (maxvalue - minvalue))
                    sliderBox.Text = tostring(Value)
                    updateSlider(Value)
                    callback(Value)
                    
                    local moveConn
                    local releaseConn
                    
                    moveConn = mouse.Move:Connect(function()
                        local newX = math.clamp(mouse.X - sliderBtn.AbsolutePosition.X, 0, 280)
                        Value = math.floor(minvalue + (newX / 280) * (maxvalue - minvalue))
                        sliderBox.Text = tostring(Value)
                        updateSlider(Value)
                        callback(Value)
                    end)
                    
                    releaseConn = uis.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            moveConn:Disconnect()
                            releaseConn:Disconnect()
                        end
                    end)
                end)
                
                sliderBox.FocusLost:Connect(function(enter)
                    if enter then
                        local newVal = tonumber(sliderBox.Text)
                        if newVal then
                            Value = math.clamp(newVal, minvalue, maxvalue)
                            sliderBox.Text = tostring(Value)
                            updateSlider(Value)
                            callback(Value)
                        end
                    end
                end)
                
                updateSlider(minvalue)
            end


            FrameToggle2.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            FrameToggle2.Position = UDim2.new(0.05, 0, 0.1, 0)
            FrameToggle2.Size = UDim2.new(0, 35, 0, 16)

            FrameToggle2Corner.CornerRadius = UDim.new(0, 8)
            FrameToggle2Corner.Name = "FrameToggle2Corner"

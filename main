local content = Instance.new("Frame")
content.BackgroundTransparency = 1
content.BorderSizePixel = 0
content.Position = UDim2.new(0, 118, 0, 24)
content.Size = UDim2.new(0, 480, 0, 420)
content.Parent = main

local function sideItem(text, icon, y, active)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundColor3 = active and rgb(34, 35, 46) or colors.side
	b.BorderSizePixel = 0
	b.Font = Enum.Font.Code
	b.Text = ""
	b.Position = UDim2.new(0, 5, 0, y)
	b.Size = UDim2.new(0, 89, 0, 74)
	b.Parent = side

	local i = label(b, icon, 0, 4, 89, 34, 31, active and colors.white or colors.muted, Enum.TextXAlignment.Center)
	i.Font = Enum.Font.SourceSansBold

	label(b, text, 0, 43, 89, 18, 12, active and colors.text or colors.muted, Enum.TextXAlignment.Center)

	b.MouseButton1Click:Connect(function()
		flash(b, b.BackgroundColor3)
	end)

	return b
end

sideItem("", "O", 14, true)
sideItem("Settings", "*", 78, false)
sideItem("Visuals", "+", 142, false)

local panel = Instance.new("Frame")
panel.BackgroundColor3 = colors.panel
panel.BorderSizePixel = 0
panel.Position = UDim2.new(0, 0, 0, 0)
panel.Size = UDim2.new(0, 239, 0, 179)
panel.Parent = content
stroke(panel, rgb(49, 50, 66))

label(panel, "ESP", 6, -1, 100, 17, 11, colors.text)
label(panel, "Slider", 7, 20, 100, 17, 11, colors.text)

local sliderBack = Instance.new("TextButton")
sliderBack.AutoButtonColor = false
sliderBack.BackgroundColor3 = colors.panelDark
sliderBack.BorderSizePixel = 0
sliderBack.Text = ""
sliderBack.Position = UDim2.new(0, 7, 0, 34)
sliderBack.Size = UDim2.new(0, 224, 0, 15)
sliderBack.Parent = panel
stroke(sliderBack, rgb(129, 98, 124))

local sliderFill = Instance.new("Frame")
sliderFill.BackgroundColor3 = colors.red
sliderFill.BorderSizePixel = 0
sliderFill.Position = UDim2.new(0, 0, 0, 0)
sliderFill.Size = UDim2.new(0, 119, 1, 0)
sliderFill.Parent = sliderBack

local knob = Instance.new("TextLabel")
knob.BackgroundTransparency = 1
knob.BorderSizePixel = 0
knob.Font = Enum.Font.SourceSansBold
knob.Text = "+"
knob.TextColor3 = colors.white
knob.TextSize = 26
knob.Position = UDim2.new(0, 100, 0, -8)
knob.Size = UDim2.new(0, 22, 0, 22)
knob.Parent = sliderBack

local draggingSlider = false
local function updateSlider(x)
	local pct = math.clamp((x - sliderBack.AbsolutePosition.X) / sliderBack.AbsoluteSize.X, 0, 1)
	sliderFill.Size = UDim2.new(pct, 0, 1, 0)
	knob.Position = UDim2.new(pct, -11, 0, -8)
end

sliderBack.MouseButton1Down:Connect(function()
	draggingSlider = true
	flash(sliderBack, colors.panelDark)
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
		updateSlider(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingSlider = false
	end
end)

local enableRow = Instance.new("TextButton")
enableRow.AutoButtonColor = false
enableRow.BackgroundTransparency = 1
enableRow.BorderSizePixel = 0
enableRow.Text = ""
enableRow.Position = UDim2.new(0, 7, 0, 54)
enableRow.Size = UDim2.new(0, 224, 0, 17)
enableRow.Parent = panel

local check = Instance.new("Frame")
check.BackgroundColor3 = rgb(31, 32, 42)
check.BorderSizePixel = 0
check.Position = UDim2.new(0, 0, 0, 4)
check.Size = UDim2.new(0, 10, 0, 10)
check.Parent = enableRow
stroke(check, rgb(58, 59, 74))

label(enableRow, "Enable", 16, 0, 100, 17, 11, colors.muted)
local enabled = false
enableRow.MouseButton1Click:Connect(function()
	enabled = not enabled
	check.BackgroundColor3 = enabled and colors.red or rgb(31, 32, 42)
	flash(enableRow, colors.panel)
end)

label(panel, "Keybind", 7, 72, 110, 16, 11, colors.muted)
local keyBtn = button(panel, "Q", 217, 74, 13, 15)
keyBtn.TextSize = 10
local waitingKey = false
local selectedKey = Enum.KeyCode.Q

keyBtn.MouseButton1Click:Connect(function()
	waitingKey = true
	keyBtn.Text = "..."
	flash(keyBtn, colors.panelDark)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if waitingKey and input.KeyCode ~= Enum.KeyCode.Unknown then
		selectedKey = input.KeyCode
		keyBtn.Text = string.sub(selectedKey.Name, 1, 1)
		waitingKey = false
	end
end)

label(panel, "Flags", 7, 94, 110, 16, 11, colors.muted)

local drop = button(panel, "Weapon                                      +", 7, 111, 224, 17)
drop.TextXAlignment = Enum.TextXAlignment.Left
drop.TextColor3 = colors.muted
drop.MouseButton1Click:Connect(function()
	flash(drop, colors.panelDark)
end)

local centerButton = button(panel, "Button", 7, 132, 224, 17)
centerButton.MouseButton1Click:Connect(function()
	flash(centerButton, colors.panelDark)
end)

label(panel, "Box Color", 7, 156, 110, 16, 11, colors.muted)

local colorBox = Instance.new("TextButton")
colorBox.AutoButtonColor = false
colorBox.BackgroundColor3 = colors.white
colorBox.BorderSizePixel = 0
colorBox.Text = ""
colorBox.Position = UDim2.new(0, 211, 0, 160)
colorBox.Size = UDim2.new(0, 19, 0, 10)
colorBox.Parent = panel
stroke(colorBox, rgb(205, 205, 211))

local redBox = false
colorBox.MouseButton1Click:Connect(function()
	redBox = not redBox
	colorBox.BackgroundColor3 = redBox and colors.red or colors.white
	flash(colorBox, colorBox.BackgroundColor3)
end)

local draggingWindow = false
local dragStart
local startPos

top.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingWindow = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

top.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingWindow = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingWindow and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

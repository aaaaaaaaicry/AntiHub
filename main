                sliderBox.TextEditable = true
                
                local UICorner_2 = Instance.new("UICorner")
                UICorner_2.CornerRadius = UDim.new(0, 4)
                UICorner_2.Parent = sliderBox
                
                local mouse = game.Players.LocalPlayer:GetMouse()
                local uis = game:GetService("UserInputService")
                local Value = minvalue
                local moveconnection
                local releaseconnection
                
                local function updateSlider(value)
                    local percent = (value - minvalue) / (maxvalue - minvalue)
                    local width = math.clamp(percent * 350, 0, 350)
                    SliderDrag:TweenSize(UDim2.new(0, width, 0, 8), "Out", "Quad", 0.1, true)
                end
                
                sliderBtn.MouseButton1Down:Connect(function()
                    local mouseX = math.clamp(mouse.X - sliderBtn.AbsolutePosition.X, 0, 350)
                    Value = math.floor(minvalue + (mouseX / 350) * (maxvalue - minvalue))
                    sliderBox.Text = tostring(Value)
                    updateSlider(Value)
                    pcall(callback, Value)
                    
                    moveconnection = mouse.Move:Connect(function()
                        local newMouseX = math.clamp(mouse.X - sliderBtn.AbsolutePosition.X, 0, 350)
                        Value = math.floor(minvalue + (newMouseX / 350) * (maxvalue - minvalue))
                        sliderBox.Text = tostring(Value)
                        updateSlider(Value)
                        pcall(callback, Value)
                    end)
                    
                    releaseconnection = uis.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            if moveconnection then moveconnection:Disconnect() end
                            if releaseconnection then releaseconnection:Disconnect() end
                        end
                    end)
                end)
                
                sliderBox.FocusLost:Connect(function(enterPressed)
                    if enterPressed then
                        local newValue = tonumber(sliderBox.Text)
                        if newValue then
                            Value = math.clamp(newValue, minvalue, maxvalue)
                            sliderBox.Text = tostring(Value)
                            updateSlider(Value)
                            pcall(callback, Value)
                        else
                            sliderBox.Text = tostring(Value)
                        end
                    end
                end)
                
                updateSlider(minvalue)
            end

            function itemHandling:Label(txtLabel)
                txtLabel = txtLabel or "nightmare.fun"
                local TextLabel = Instance.new("TextLabel")

                TextLabel.Parent = sectionFrame
                TextLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                TextLabel.BackgroundTransparency = 1.000
                TextLabel.Size = UDim2.new(0, 400, 0, 25)
                TextLabel.Font = Enum.Font.Gotham
                TextLabel.Text = txtLabel
                TextLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
                TextLabel.TextSize = 13.000
                TextLabel.TextXAlignment = Enum.TextXAlignment.Left
            end

            function itemHandling:KeyBind(bindInfo, first, callback)
                bindInfo = bindInfo or "Press the Key"
                local oldKey = first.Name
                callback = callback or function() end

                local keybindFrame = Instance.new("Frame")
                local UIListLayout = Instance.new("UIListLayout")
                local keybindBtn = Instance.new("TextButton")
                local UICorner = Instance.new("UICorner")
                local TextLabel = Instance.new("TextLabel")

                keybindFrame.Name = "keybindFrame"
                keybindFrame.Parent = sectionFrame
                keybindFrame.BackgroundColor3 = Color3.fromRGB(43, 43, 52)
                keybindFrame.BackgroundTransparency = 1.000
                keybindFrame.Size = UDim2.new(0, 400, 0, 35)

                UIListLayout.Parent = keybindFrame
                UIListLayout.FillDirection = Enum.FillDirection.Horizontal
                UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
                UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Center
                UIListLayout.Padding = UDim.new(0, 10)

                keybindBtn.Name = "keybindBtn"
                keybindBtn.Parent = keybindFrame
                keybindBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
                keybindBtn.Size = UDim2.new(0, 100, 0, 30)
                keybindBtn.AutoButtonColor = false
                keybindBtn.Font = Enum.Font.GothamSemibold
                keybindBtn.Text = oldKey
                keybindBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
                keybindBtn.TextSize = 13.000

                UICorner.CornerRadius = UDim.new(0, 6)
                UICorner.Parent = keybindBtn

                TextLabel.Parent = keybindFrame
                TextLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                TextLabel.BackgroundTransparency = 1.000
                TextLabel.Size = UDim2.new(0, 280, 0, 25)
                TextLabel.Font = Enum.Font.Gotham
                TextLabel.Text = bindInfo
                TextLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
                TextLabel.TextSize = 14.000
                TextLabel.TextXAlignment = Enum.TextXAlignment.Left

                keybindBtn.MouseButton1Click:connect(function() 
                    keybindBtn.Text = "..."
                    local input = game:GetService('UserInputService').InputBegan:wait()
                    if input.KeyCode.Name ~= "Unknown" then
                        keybindBtn.Text = input.KeyCode.Name
                        oldKey = input.KeyCode.Name
                    end
                end)
            
                game:GetService("UserInputService").InputBegan:connect(function(current, processed) 
                    if not processed then 
                        if current.KeyCode.Name == oldKey then 
                            callback()
                        end
                    end
                end)
            end

            function itemHandling:Dropdown(dropInfo, list, callback)
                dropInfo = dropInfo or 'Select Option'
                list = list or {}
                callback = callback or function() end

                local DropYSize = 35
                local dropped = false

                local dropdownFrame = Instance.new("Frame")
                local dropdownFrameHeader = Instance.new("Frame")
                local UICorner = Instance.new("UICorner")
                local dropdowninfo = Instance.new("TextLabel")
                local closeDropdown = Instance.new("ImageButton")
                local dropListing = Instance.new("UIListLayout")
                local dropdownCorner = Instance.new("UICorner")

                dropdownFrame.Name = "dropdownFrame"
                dropdownFrame.Parent = sectionFrame
                dropdownFrame.BackgroundColor3 = Color3.fromRGB(48, 48, 58)
                dropdownFrame.ClipsDescendants = true
                dropdownFrame.Size = UDim2.new(0, 400, 0, 35)

                dropdownFrameHeader.Name = "dropdownFrameHeader"
                dropdownFrameHeader.Parent = dropdownFrame
                dropdownFrameHeader.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
                dropdownFrameHeader.Size = UDim2.new(0, 400, 0, 35)

                UICorner.CornerRadius = UDim.new(0, 6)
                UICorner.Parent = dropdownFrameHeader

                dropdowninfo.Name = "dropdowninfo"
                dropdowninfo.Parent = dropdownFrameHeader
                dropdowninfo.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                dropdowninfo.BackgroundTransparency = 1.000
                dropdowninfo.Position = UDim2.new(0.03, 0, 0, 0)
                dropdowninfo.Size = UDim2.new(0, 350, 0, 35)
                dropdowninfo.Font = Enum.Font.Gotham
                dropdowninfo.Text = dropInfo
                dropdowninfo.TextColor3 = Color3.fromRGB(180, 180, 200)
                dropdowninfo.TextSize = 14.000
                dropdowninfo.TextXAlignment = Enum.TextXAlignment.Left

                closeDropdown.Name = "closeDropdown"
                closeDropdown.Parent = dropdownFrameHeader
                closeDropdown.BackgroundTransparency = 1.000
                closeDropdown.Position = UDim2.new(0.93, 0, 0.1, 0)
                closeDropdown.Size = UDim2.new(0, 28, 0, 28)
                closeDropdown.ZIndex = 2
                closeDropdown.Image = "rbxassetid://3926305904"
                closeDropdown.ImageColor3 = Color3.fromRGB(150, 150, 170)
                closeDropdown.ImageRectOffset = Vector2.new(404, 284)
                closeDropdown.ImageRectSize = Vector2.new(36, 36)
                closeDropdown.MouseButton1Click:Connect(function()
                    if dropped then
                        dropped = false
                        dropdownFrame:TweenSize(UDim2.new(0, 400, 0, 35), 'InOut', 'Linear', 0.08)
                        game.TweenService:Create(closeDropdown, TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
                            Rotation = 0
                        }):Play()
                        wait(0.1)
                        UpdateSize()
                    else
                        dropped = true
                        dropdownFrame:TweenSize(UDim2.new(0, 400, 0, DropYSize), 'InOut', 'Linear', 0.08)
                        game.TweenService:Create(closeDropdown, TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
                            Rotation = 180
                        }):Play()
                        wait(0.1)
                        UpdateSize()
                    end
                end)

                dropListing.Name = "dropListing"
                dropListing.Parent = dropdownFrame
                dropListing.HorizontalAlignment = Enum.HorizontalAlignment.Center
                dropListing.SortOrder = Enum.SortOrder.LayoutOrder
                dropListing.Padding = UDim.new(0, 4)

                dropdownCorner.CornerRadius = UDim.new(0, 6)
                dropdownCorner.Name = "dropdownCorner"
                dropdownCorner.Parent = dropdownFrame

                for i,v in next, list do
                    local optionButton = Instance.new("TextButton")
                    local optionCorner = Instance.new("UICorner")

                    optionButton.Name = "optionButton"
                    optionButton.Parent = dropdownFrame
                    optionButton.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
                    optionButton.Size = UDim2.new(0, 390, 0, 32)
                    optionButton.AutoButtonColor = false
                    optionButton.Font = Enum.Font.Gotham
                    optionButton.Text = "  "..v
                    optionButton.TextColor3 = Color3.fromRGB(180, 180, 200)
                    optionButton.TextSize = 13.000
                    optionButton.TextXAlignment = Enum.TextXAlignment.Left
                    
                    optionCorner.CornerRadius = UDim.new(0, 4)
                    optionCorner.Parent = optionButton
                    
                    DropYSize = DropYSize + 36
                    
                    optionButton.MouseButton1Click:Connect(function()
                        dropped = false
                        dropdowninfo.Text = v
                        dropdowninfo.TextColor3 = Color3.fromRGB(200, 50, 50)
                        callback(v)
                        dropdownFrame:TweenSize(UDim2.new(0, 400, 0, 35), 'InOut', 'Linear', 0.08)
                        game.TweenService:Create(closeDropdown, TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
                            Rotation = 0
                        }):Play()
                        wait(0.1)
                        UpdateSize()
                    end)

                    optionButton.MouseEnter:Connect(function()
                        game.TweenService:Create(optionButton, TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
                            BackgroundColor3 = Color3.fromRGB(65, 65, 75)
                        }):Play()
                    end)
                    
                    optionButton.MouseLeave:Connect(function()
                        game.TweenService:Create(optionButton, TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
                            BackgroundColor3 = Color3.fromRGB(55, 55, 65)
                        }):Play()
                    end)
                end 
            end
            
            return itemHandling
        end
        return sectionHandling
    end
    return tabHandling
end

return Fun

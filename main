}, {
	corner(5),
	stroke(state.accent, 0.2, 1),
})

local nav = new("Frame", {
	BackgroundTransparency = 1,
	Position = UDim2.fromOffset(25, 6),
	Size = UDim2.fromOffset(236, 52),
	Parent = bottom,
}, {
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

local tabMeta = {
	Aimbot = { icon = tabSymbols.Aimbot, subtitle = "wooo cool description thingyY" },
	Visuals = { icon = tabSymbols.Visuals, subtitle = "render, colors and indicators" },
	Misc = { icon = tabSymbols.Misc, subtitle = "config, binds and session tools" },
}

local function setTabSymbol(name, symbol)
	if not tabMeta[name] then
		return
	end

	symbol = tostring(symbol or "")
	tabSymbols[name] = symbol
	tabMeta[name].icon = symbol

	if tabs[name] then
		local image = symbolToImage(symbol)
		tabs[name].iconText.Text = image and "" or symbol
		tabs[name].iconImage.Image = image or ""
		tabs[name].iconImage.Visible = image ~= nil
		tabs[name].iconText.Visible = image == nil
	end
end

if typeof(getgenv) == "function" then
	getgenv().AntiHubSetTabSymbol = setTabSymbol
end

local function setTab(name)
	if state.tab == name then
		return
	end

	local oldName = state.tab
	state.tab = name
	titleLabel.Text = name
	subtitleLabel.Text = tabMeta[name].subtitle

	for tabName, button in pairs(tabs) do
		local active = tabName == name
		tween(button.frame, 0.18, {
			BackgroundColor3 = active and theme.black or Color3.fromRGB(21, 22, 22),
			BackgroundTransparency = active and 0 or 1,
		})
		tween(button.text, 0.18, { TextColor3 = active and theme.text or theme.dim })
		tween(button.iconText, 0.18, { TextColor3 = active and theme.text or theme.dim })
		tween(button.iconImage, 0.18, { ImageColor3 = active and theme.text or theme.dim })
	end

	local old = pages[oldName] and pages[oldName].page
	local nextPage = pages[name] and pages[name].page

	if old then
		local oldTween = tween(old, 0.15, { GroupTransparency = 1, Position = UDim2.fromOffset(-12, 0) })
		oldTween.Completed:Connect(function()
			if state.tab ~= oldName and old.Parent then
				old.Visible = false
			end
		end)
	end

	if nextPage then
		nextPage.Visible = true
		nextPage.Position = UDim2.fromOffset(14, 0)
		nextPage.GroupTransparency = 1
		tween(nextPage, 0.22, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
	end
end

local function createTab(name, order)
	local active = name == state.tab
	local button = new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = active and theme.black or Color3.fromRGB(21, 22, 22),
		BackgroundTransparency = active and 0 or 1,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Size = UDim2.fromOffset(72, 52),
		Text = "",
		Parent = nav,
	}, {
		corner(2),
	})

	local image = symbolToImage(tabMeta[name].icon)
	local iconImage = new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = image or "",
		ImageColor3 = active and theme.text or theme.dim,
		Position = UDim2.fromOffset(26, 8),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(20, 20),
		Visible = image ~= nil,
		Parent = button,
	})

	local iconText = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(0, 7),
		Size = UDim2.new(1, 0, 0, 19),
		Text = image and "" or tabMeta[name].icon,
		TextColor3 = active and theme.text or theme.dim,
		TextSize = 20,
		Visible = image == nil,
		Parent = button,
	})

	local text = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 15),
		Text = name,
		TextColor3 = active and theme.text or theme.dim,
		TextSize = 11,
		Parent = button,
	})

	tabs[name] = { frame = button, iconText = iconText, iconImage = iconImage, text = text }

	button.MouseEnter:Connect(function()
		if state.tab ~= name then
			tween(button, 0.14, { BackgroundTransparency = 0.55 })
		end
	end)
	button.MouseLeave:Connect(function()
		if state.tab ~= name then
			tween(button, 0.16, { BackgroundTransparency = 1 })
		end
	end)
	button.MouseButton1Click:Connect(function()
		setTab(name)
	end)
end

createTab("Aimbot", 1)
createTab("Visuals", 2)
createTab("Misc", 3)


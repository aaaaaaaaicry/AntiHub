local pages = {}
local tabs = {}

local function makePage(name)
	local page = new("CanvasGroup", {
		Name = name .. "Page",
		BackgroundTransparency = 1,
		GroupTransparency = name == "Aimbot" and 0 or 1,
		Position = UDim2.fromOffset(name == "Aimbot" and 0 or 14, 0),
		Size = UDim2.fromScale(1, 1),
		Visible = name == "Aimbot",
		Parent = pageHost,
	})

	local left = new("Frame", {
		Name = "Left",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(300, 318),
		Parent = page,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local right = new("Frame", {
		Name = "Right",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(330, 0),
		Size = UDim2.fromOffset(300, 318),
		Parent = page,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	pages[name] = { page = page, left = left, right = right }
	return pages[name]
end

local function section(parent, title, height, order)
	local frame = new("Frame", {
		BackgroundTransparency = 1,
		LayoutOrder = order or 1,
		Size = UDim2.fromOffset(300, height),
		Parent = parent,
	})

	new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(7, 0),
		Size = UDim2.fromOffset(220, 18),
		Text = string.upper(title),
		TextColor3 = Color3.fromRGB(168, 170, 177),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})

	local body = new("Frame", {
		BackgroundColor3 = theme.panel3,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 17),
		Size = UDim2.new(1, 0, 1, -17),
		Parent = frame,
	}, {
		corner(5),
		stroke(theme.stroke, 0.75, 1),
		padding(8, 8, 7, 7),
		new("UIListLayout", {
			Padding = UDim.new(0, 5),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	return body, frame
end

local function row(parent, height)
	return new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 25),
		Parent = parent,
	})
end

local function createToggle(parent, key, label, default, showCog, callback)
	state.values[key] = default

	local r = row(parent, 25)
	new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -80, 1, 0),
		Text = label,
		TextColor3 = Color3.fromRGB(212, 213, 218),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = r,
	})

	if showCog then
		new("TextLabel", {
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.new(1, -54, 0.5, 0),
			Size = UDim2.fromOffset(18, 18),
			Text = "*",
			TextColor3 = Color3.fromRGB(214, 216, 222),
			TextSize = 18,
			Parent = r,
		})
	end

	local holder = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		AutoButtonColor = false,
		BackgroundColor3 = default and state.accent or Color3.fromRGB(58, 60, 64),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(38, 20),
		Text = "",
		Parent = r,
	}, {
		corner(10),
	})

	local knob = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(244, 245, 247),
		BorderSizePixel = 0,
		Position = default and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2),
		Size = UDim2.fromOffset(16, 16),
		Parent = holder,
	}, {
		corner(8),
	})

	local function update()
		local enabled = state.values[key]
		tween(holder, 0.18, { BackgroundColor3 = enabled and state.accent or Color3.fromRGB(58, 60, 64) })
		tween(knob, 0.18, { Position = enabled and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2) })
	end

	onAccentChanged(update)

	local function setValue(value)
		state.values[key] = value == true
		update()
		if callback then
			callback(state.values[key])
		end
	end

	holder.MouseButton1Click:Connect(function()
		setValue(not state.values[key])
	end)

	registerSetter(key, setValue)
	setValue(state.values[key])

	return holder
end

local function createSlider(parent, key, label, min, max, default, suffix, callback)
	state.values[key] = default

	local r = row(parent, 35)
	new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -76, 0, 17),
		Text = label,
		TextColor3 = Color3.fromRGB(210, 212, 217),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = r,
	})

	local valueBox = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -6, 0, 0),
		Size = UDim2.fromOffset(38, 25),
		TextColor3 = Color3.fromRGB(210, 212, 217),
		TextSize = 11,
		Parent = r,
	}, {
		corner(4),
	})

	local track = new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(16, 17, 17),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(4, 24),
		Size = UDim2.new(1, -74, 0, 3),
		Text = "",
		Parent = r,
	})

	local fill = new("Frame", {
		BackgroundColor3 = state.accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})

	onAccentChanged(function()
		tween(fill, 0.18, { BackgroundColor3 = state.accent })
	end)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(242, 243, 245),
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(15, 15),
		Parent = track,
	}, {
		corner(8),
	})

	local dragging = false

	local function formatValue(value)
		local rounded = math.floor(value + 0.5)
		return suffix and (tostring(rounded) .. suffix) or tostring(rounded)
	end

	local function setValueFromAlpha(alpha, animate)
		alpha = math.clamp(alpha, 0, 1)
		local value = min + (max - min) * alpha
		state.values[key] = value
		valueBox.Text = formatValue(value)
		local props = { Size = UDim2.fromScale(alpha, 1) }
		local knobProps = { Position = UDim2.fromScale(alpha, 0.5) }
		if animate then
			tween(fill, 0.14, props)
			tween(knob, 0.14, knobProps)
		else
			fill.Size = props.Size
			knob.Position = knobProps.Position
		end
		if callback then
			callback(state.values[key])
		end
	end

	local function setValue(value)
		value = tonumber(value) or default
		value = math.clamp(value, min, max)
		setValueFromAlpha((value - min) / (max - min), true)
	end

	local function alphaFromInput(input)
		return (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setValueFromAlpha(alphaFromInput(input), false)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setValueFromAlpha(alphaFromInput(input), false)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	registerSetter(key, setValue)
	setValue(state.values[key])
	return r
end

local colorPickers = {}
updateAccent = function(color)
	state.accent = color
	for _, data in ipairs(colorPickers) do
		data.swatch.BackgroundColor3 = color
		data.value.Text = "#" .. color:ToHex():lower()
	end
	for _, callback in ipairs(accentUpdaters) do
		task.spawn(callback)
	end
end

local function createColorPicker(parent, label, defaultColor)
	updateAccent(defaultColor)

	local r = row(parent, 34)
	new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -96, 1, 0),
		Text = label,
		TextColor3 = Color3.fromRGB(213, 214, 219),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = r,
	})

	local value = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.new(1, -41, 0.5, 0),
		Size = UDim2.fromOffset(61, 28),
		Text = "#" .. defaultColor:ToHex():lower(),
		TextColor3 = Color3.fromRGB(210, 212, 218),
		TextSize = 12,
		Parent = r,
	}, {
		corner(4),
	})

	local swatch = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		AutoButtonColor = false,
		BackgroundColor3 = defaultColor,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -7, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		Text = "",
		Parent = r,
	}, {
		corner(8),
		stroke(Color3.fromRGB(220, 222, 227), 0.65, 1),
	})

	local palette = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -4, 1, 2),
		Size = UDim2.fromOffset(142, 32),
		Visible = false,
		ZIndex = 30,
		Parent = r,
	}, {
		corner(5),
		stroke(theme.stroke, 0.45, 1),
		padding(6, 6, 6, 6),
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local colors = {
		Color3.fromRGB(146, 154, 171),
		Color3.fromRGB(117, 174, 129),
		Color3.fromRGB(218, 170, 91),
		Color3.fromRGB(196, 111, 128),
		Color3.fromRGB(116, 164, 204),
	}

	for index, color in ipairs(colors) do
		local item = new("TextButton", {
			AutoButtonColor = false,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Size = UDim2.fromOffset(19, 19),
			Text = "",
			ZIndex = 31,
			Parent = palette,
		}, {
			corner(10),
		})
		item.MouseButton1Click:Connect(function()
			updateAccent(color)
			palette.Visible = false
		end)
	end

	swatch.MouseButton1Click:Connect(function()
		palette.Visible = not palette.Visible
	end)

	table.insert(colorPickers, { swatch = swatch, value = value })
	return r
end

local function createButton(parent, text, widthScale, callback)
	local b = new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Size = widthScale and UDim2.new(widthScale, -3, 0, 29) or UDim2.new(1, 0, 0, 29),
		Text = text,
		TextColor3 = Color3.fromRGB(228, 229, 233),
		TextSize = 12,
		Parent = parent,
	}, {
		corner(3),
		stroke(theme.stroke, 0.85, 1),
	})

	b.MouseEnter:Connect(function()
		tween(b, 0.15, { BackgroundColor3 = theme.panel2, TextColor3 = Color3.fromRGB(255, 255, 255) })
	end)
	b.MouseLeave:Connect(function()
		tween(b, 0.18, { BackgroundColor3 = theme.panel, TextColor3 = Color3.fromRGB(228, 229, 233) })
	end)
	b.MouseButton1Down:Connect(function()
		tween(b, 0.08, { Size = widthScale and UDim2.new(widthScale, -7, 0, 27) or UDim2.new(1, -4, 0, 27) })
	end)
	b.MouseButton1Up:Connect(function()
		tween(b, 0.12, { Size = widthScale and UDim2.new(widthScale, -3, 0, 29) or UDim2.new(1, 0, 0, 29) })
	end)
	b.MouseButton1Click:Connect(function()
		if callback then
			callback()
		end
	end)

	return b
end

local openDropdown
local function createDropdown(parent, key, label, options, default, callback)
	state.values[key] = default or options[1]

	local r = row(parent, 31)
	r.ZIndex = 40
	new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(0.52, 0, 1, 0),
		Text = label,
		TextColor3 = Color3.fromRGB(205, 207, 212),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = r,
	})

	local button = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		AutoButtonColor = false,
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.new(1, -4, 0.5, 0),
		Size = UDim2.fromOffset(142, 30),
		Text = "",
		ZIndex = 41,
		Parent = r,
	}, {
		corner(4),
	})

	local selected = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -28, 1, 0),
		Text = state.values[key],
		TextColor3 = Color3.fromRGB(220, 222, 227),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 42,
		Parent = button,
	})

	local arrow = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.new(1, -9, 0, 0),
		Size = UDim2.fromOffset(13, 30),
		Text = "v",
		TextColor3 = theme.dim,
		TextSize = 12,
		ZIndex = 42,
		Parent = button,
	})

	local menu = new("CanvasGroup", {
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Position = UDim2.new(1, -4, 1, 1),
		Size = UDim2.fromOffset(142, 0),
		Visible = false,
		ZIndex = 200,
		Parent = r,
	}, {
		corner(4),
		stroke(theme.stroke, 0.55, 1),
	})

	local list = new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})

	local dropdownData = {}
	local optionViews = {}
	local optionButtons = {}

	local function hasOption(value)
		for _, option in ipairs(options) do
			if option == value then
				return true
			end
		end
		return false
	end

	local function setValue(value)
		if not hasOption(value) then
			value = default or options[1]
		end
		state.values[key] = value
		selected.Text = value
		for optionName, view in pairs(optionViews) do
			local active = optionName == value
			tween(view.button, 0.12, {
				BackgroundColor3 = active and Color3.fromRGB(38, 24, 26) or theme.panel,
				TextColor3 = active and state.accent or Color3.fromRGB(219, 221, 226),
			})
			tween(view.marker, 0.12, {
				BackgroundTransparency = active and 0 or 1,
				Size = active and UDim2.fromOffset(3, 18) or UDim2.fromOffset(3, 4),
			})
		end
		if callback then
			callback(value)
		end
	end

	for index, option in ipairs(options) do
		local opt = new("TextButton", {
			AutoButtonColor = false,
			BackgroundColor3 = theme.panel,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamMedium,
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 28),
			Text = "  " .. option,
			TextColor3 = Color3.fromRGB(219, 221, 226),
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 51,
			Parent = menu,
		}, {
			padding(12, 8, 0, 0),
		})

		local marker = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = state.accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 5, 0.5, 0),
			Size = UDim2.fromOffset(3, 4),
			ZIndex = 52,
			Parent = opt,
		}, {
			corner(2),
		})

		optionViews[option] = { button = opt, marker = marker }
		table.insert(optionButtons, opt)
		onAccentChanged(function()
			marker.BackgroundColor3 = state.accent
			if state.values[key] == option then
				opt.TextColor3 = state.accent
			end
		end)

		opt.MouseEnter:Connect(function()
			if state.values[key] ~= option then
				tween(opt, 0.12, { BackgroundColor3 = Color3.fromRGB(39, 41, 43) })
			end
		end)
		opt.MouseLeave:Connect(function()
			if state.values[key] ~= option then
				tween(opt, 0.16, { BackgroundColor3 = theme.panel })
			end
		end)
		opt.MouseButton1Click:Connect(function()
			setValue(option)
			if dropdownData.close then
				dropdownData.close()
			end
		end)
	end

	local function open()
		if openDropdown and openDropdown ~= dropdownData and openDropdown.close then
			openDropdown.close()
		end
		openDropdown = dropdownData
		r.ZIndex = 190
		menu.ZIndex = 200
		for _, opt in ipairs(optionButtons) do
			opt.ZIndex = 201
			for _, item in ipairs(opt:GetDescendants()) do
				if item:IsA("GuiObject") then
					item.ZIndex = 202
				end
			end
		end
		menu.Visible = true
		arrow.Text = "^"
		tween(menu, 0.18, { Size = UDim2.fromOffset(142, math.min(#options, 5) * 28), GroupTransparency = 0 })
	end

	local function close()
		arrow.Text = "v"
		local t = tween(menu, 0.14, { Size = UDim2.fromOffset(142, 0), GroupTransparency = 1 })
		t.Completed:Connect(function()
			if menu.GroupTransparency >= 1 then
				menu.Visible = false
				r.ZIndex = 40
			end
		end)
	end

	dropdownData.close = close
	button.MouseButton1Click:Connect(function()
		if menu.Visible then
			close()
		else
			open()
		end
	end)

	registerSetter(key, setValue)
	setValue(state.values[key])

	return r
end

local function createKeyPicker(parent, key, label, defaultKey, callback)
	state.values[key] = defaultKey or "RightShift"

	local r = row(parent, 31)
	new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(0.52, 0, 1, 0),
		Text = label,
		TextColor3 = Color3.fromRGB(205, 207, 212),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = r,
	})

	local button = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		AutoButtonColor = false,
		BackgroundColor3 = theme.panel,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.new(1, -4, 0.5, 0),
		Size = UDim2.fromOffset(142, 30),
		Text = "",
		Parent = r,
	}, {
		corner(4),
		stroke(theme.stroke, 0.8, 1),
	})

	local valueText = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Text = tostring(state.values[key]),
		TextColor3 = Color3.fromRGB(220, 222, 227),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = button,
	})

	local picking = false
	local inputConnection

	local function setValue(value)
		value = tostring(value or defaultKey or "RightShift")
		state.values[key] = value
		valueText.Text = value
		tween(button, 0.15, { BackgroundColor3 = theme.panel })
		tween(valueText, 0.15, { TextColor3 = Color3.fromRGB(220, 222, 227) })
		if callback then
			callback(value)
		end
	end

	local function stopPicking()
		picking = false
		if inputConnection then
			inputConnection:Disconnect()
			inputConnection = nil
		end
	end

	button.MouseButton1Click:Connect(function()
		if picking then
			stopPicking()
			setValue(state.values[key])
			return
		end

		picking = true
		valueText.Text = "press key"
		tween(button, 0.15, { BackgroundColor3 = Color3.fromRGB(38, 24, 26) })
		tween(valueText, 0.15, { TextColor3 = state.accent })

		inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
			if processed then
				return
			end

			local chosen
			if input.UserInputType == Enum.UserInputType.Keyboard then
				chosen = input.KeyCode.Name
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
				chosen = "MouseButton1"
			elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
				chosen = "MouseButton2"
			elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
				chosen = "MouseButton3"
			end

			if chosen then
				stopPicking()
				setValue(chosen)
			end
		end)
	end)

	button.MouseEnter:Connect(function()
		if not picking then
			tween(button, 0.12, { BackgroundColor3 = theme.panel2 })
		end
	end)
	button.MouseLeave:Connect(function()
		if not picking then
			tween(button, 0.14, { BackgroundColor3 = theme.panel })
		end
	end)
	onAccentChanged(function()
		if picking then
			valueText.TextColor3 = state.accent
		end
	end)

	registerSetter(key, setValue)
	setValue(state.values[key])

	return r
end

local function buildAimbot()
	local page = makePage("Aimbot")

	local toggles = section(page.left, "Main", 110, 1)
	createToggle(toggles, "tear", "Tear me to pieces", true, true)
	createToggle(toggles, "skin", "Skin to bone", true, false)
	createToggle(toggles, "hello", "Hello, welcome home", false, false)

	local sliders = section(page.left, "Aim settings", 110, 2)
	createSlider(sliders, "zu_krass", "zu krass  (>-<)", 0, 100, 70, "%")
	createSlider(sliders, "fov", "Aimbot FOV", 0, 180, 90, " deg")

	local picker = section(page.left, "Accent", 64, 3)
	createColorPicker(picker, "ui accent", state.accent)

	local dropdowns = section(page.right, "Target", 118, 1)
	createDropdown(dropdowns, "hitbox", "Target Hitbox", {
		"Head - active",
		"Torso - inactive",
		"Arms - hover",
		"Legs - hidden",
	}, "Head - active")
	createDropdown(dropdowns, "since", "Since when", {
		"Always",
		"On key",
		"Visible only",
		"Closest",
	}, "Always")
end

